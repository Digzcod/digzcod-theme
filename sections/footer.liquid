{%- liquid
  assign footer_id = 'Footer-' | append: section.id
  assign show_newsletter = section.settings.show_newsletter
  assign newsletter_heading = section.settings.newsletter_heading
  assign newsletter_text = section.settings.newsletter_text
  assign show_social_icons = section.settings.show_social_icons
  assign show_payment_icons = section.settings.show_payment_icons
  assign copyright_text = section.settings.copyright_text
  assign color_scheme = section.settings.color_scheme
  assign layout_style = section.settings.layout_style
  assign enable_country_selector = section.settings.enable_country_selector
  assign enable_language_selector = section.settings.enable_language_selector
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign content_spacing = section.settings.content_spacing
  assign block_spacing = section.settings.block_spacing
  assign heading_size = section.settings.heading_size
  assign text_size = section.settings.text_size
  assign mobile_center_content = section.settings.mobile_center_content
  assign mobile_stack_layout = section.settings.mobile_stack_layout
-%}

<footer
  id="{{ footer_id }}"
  class="footer section-{{ section.id }}"
  data-color-scheme="{{ color_scheme }}"
  data-layout-style="{{ layout_style }}"
  data-heading-size="{{ heading_size }}"
  data-text-size="{{ text_size }}"
  data-mobile-center="{{ mobile_center_content }}"
  data-mobile-stack="{{ mobile_stack_layout }}"
  style="
    --footer-padding-top: {{ padding_top }}rem;
    --footer-padding-bottom: {{ padding_bottom }}rem;
    --footer-content-spacing: {{ content_spacing }}rem;
    --footer-block-spacing: {{ block_spacing }}rem;
  "
  role="contentinfo">
  <div class="footer__container">
    {%- if section.blocks.size > 0 or show_newsletter -%}
      <div class="footer__content">
        {%- if show_newsletter -%}
          <div class="footer__newsletter">
            {%- if newsletter_heading != blank -%}
              <h3 class="footer__newsletter-heading">{{ newsletter_heading }}</h3>
            {%- endif -%}
            {%- if newsletter_text != blank -%}
              <p class="footer__newsletter-text">{{ newsletter_text }}</p>
            {%- endif -%}

            {% form 'customer'
              , class: 'footer__newsletter-form' %}
              {%- if form.posted_successfully? -%}
                <div class="footer__newsletter-success" role="status">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true">
                    <path d="M20 6L9 17l-5-5" />
                  </svg>
                  {{ 'footer.newsletter.success' | t }}
                </div>
              {%- endif -%}

              {%- if form.errors -%}
                <div class="footer__newsletter-error" role="alert">
                  {{ form.errors | default_errors }}
                </div>
              {%- endif -%}

              <div class="footer__newsletter-input-wrapper">
                <input
                  type="email"
                  name="contact[email]"
                  id="newsletter-{{ section.id }}"
                  class="footer__newsletter-input"
                  placeholder="{{ 'footer.newsletter.placeholder' | t }}"
                  aria-label="{{ 'footer.newsletter.placeholder' | t }}"
                  required
                  autocomplete="email">
                <button
                  type="submit"
                  class="footer__newsletter-button"
                  aria-label="{{ 'footer.newsletter.submit' | t }}">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true">
                    <line
                      x1="22"
                      y1="2"
                      x2="11"
                      y2="13" />
                    <polygon points="22,2 15,22 11,13 2,9" />
                  </svg>
                  <span class="visually-hidden">{{ 'footer.newsletter.submit' | t }}</span>
                </button>
              </div>

              <input
                type="hidden"
                name="contact[tags]"
                value="newsletter">
            {% endform %}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="footer__blocks">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'link_list' -%}
                  {%- if block.settings.menu != blank -%}
                    <div class="footer__block footer__menu" {{ block.shopify_attributes }}>
                      <h4 class="footer__block-heading">{{ block.settings.heading | default: block.settings.menu.title }}</h4>
                      <ul class="footer__menu-list" role="list">
                        {%- for link in block.settings.menu.links -%}
                          <li class="footer__menu-item">
                            <a href="{{ link.url }}" class="footer__menu-link">
                              {{ link.title }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- endif -%}

                {%- when 'text' -%}
                  <div class="footer__block footer__text" {{ block.shopify_attributes }}>
                    {%- if block.settings.heading != blank -%}
                      <h4 class="footer__block-heading">{{ block.settings.heading }}</h4>
                    {%- endif -%}
                    {%- if block.settings.content != blank -%}
                      <div class="footer__text-content">{{ block.settings.content }}</div>
                    {%- endif -%}
                  </div>

                {%- when 'image' -%}
                  <div
                    class="footer__block footer__image"
                    data-alignment="{{ block.settings.alignment | default: 'left' }}"
                    {{ block.shopify_attributes }}>
                    {%- if block.settings.heading != blank -%}
                      <h4 class="footer__block-heading">{{ block.settings.heading }}</h4>
                    {%- endif -%}
                    {%- if block.settings.image != blank -%}
                      {%- assign image_alt = block.settings.image.alt | default: shop.name -%}
                      {%- assign image_width = block.settings.image_width | default: 150 -%}
                      <div class="footer__image-wrapper" style="--image-width: {{ image_width }}px;">
                        {{- block.settings.image | image_url: width: image_width, height: 100 | image_tag: 
 alt: image_alt,
 width: block.settings.image.width,
 height: block.settings.image.height,
 loading: 'lazy' -}}
                      </div>
                    {%- endif -%}
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="footer__bottom">
      <div class="footer__bottom-left">
        <div class="footer__copyright">
          {%- if copyright_text != blank -%}
            {{ copyright_text }}
          {%- else -%}
            &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.copyright.all_rights_reserved' | t }}
          {%- endif -%}
        </div>

        {%- if show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <div class="footer__payment">
            <span class="visually-hidden">{{ 'footer.payment.methods' | t }}</span>
            <div class="footer__payment-icons">
              {%- for type in shop.enabled_payment_types -%}
                {{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      <div class="footer__bottom-right">
        {%- if show_social_icons -%}
          <div class="footer__social">
            <span class="visually-hidden">{{ 'footer.social.follow_us' | t }}</span>
            {%- if settings.social_twitter_link != blank -%}
              <a
                href="{{ settings.social_twitter_link }}"
                class="footer__social-link"
                aria-label="{{ 'footer.social.twitter' | t }}">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true">
                  <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z" />
                </svg>
              </a>
            {%- endif -%}
            {%- if settings.social_facebook_link != blank -%}
              <a
                href="{{ settings.social_facebook_link }}"
                class="footer__social-link"
                aria-label="{{ 'footer.social.facebook' | t }}">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                </svg>
              </a>
            {%- endif -%}
            {%- if settings.social_instagram_link != blank -%}
              <a
                href="{{ settings.social_instagram_link }}"
                class="footer__social-link"
                aria-label="{{ 'footer.social.instagram' | t }}">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true">
                  <rect
                    x="2"
                    y="2"
                    width="20"
                    height="20"
                    rx="5"
                    ry="5" />
                  <path d="m16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                  <line
                    x1="17.5"
                    y1="6.5"
                    x2="17.51"
                    y2="6.5" />
                </svg>
              </a>
            {%- endif -%}
            {%- if settings.social_youtube_link != blank -%}
              <a
                href="{{ settings.social_youtube_link }}"
                class="footer__social-link"
                aria-label="{{ 'footer.social.youtube' | t }}">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true">
                  <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z" />
                  <polygon points="9.75,15.02 15.5,11.75 9.75,8.48" />
                </svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if enable_country_selector or enable_language_selector -%}
          <div class="footer__localization">
            {%- if enable_country_selector and localization.available_countries.size > 1 -%}
              {%- form 'localization'
                , class: 'footer__localization-form' -%}
                <label for="footer-country-selector" class="visually-hidden">{{ 'footer.localization.country' | t }}</label>
                <select
                  name="country_code"
                  id="footer-country-selector"
                  class="footer__localization-select"
                  aria-label="{{ 'footer.localization.country' | t }}">
                  {%- for country in localization.available_countries -%}
                    <option
                      value="{{ country.iso_code }}"
                      {% if country.iso_code == localization.country.iso_code %}
                      selected{% endif %}>
                      {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                    </option>
                  {%- endfor -%}
                </select>
              {%- endform -%}
            {%- endif -%}

            {%- if enable_language_selector and localization.available_languages.size > 1 -%}
              {%- form 'localization'
                , class: 'footer__localization-form' -%}
                <label for="footer-language-selector" class="visually-hidden">{{ 'footer.localization.language' | t }}</label>
                <select
                  name="locale_code"
                  id="footer-language-selector"
                  class="footer__localization-select"
                  aria-label="{{ 'footer.localization.language' | t }}">
                  {%- for language in localization.available_languages -%}
                    <option
                      value="{{ language.iso_code }}"
                      {% if language.iso_code == localization.language.iso_code %}
                      selected{% endif %}>
                      {{ language.endonym_name | capitalize }}
                    </option>
                  {%- endfor -%}
                </select>
              {%- endform -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    --footer-padding-top: 4rem;
    --footer-padding-bottom: 3rem;
    --footer-bottom-padding: 2rem;
    --footer-container-max-width: 1200px;
    --footer-container-padding: 2rem;
    --footer-content-spacing: 3rem;
    --footer-block-spacing: 2rem;
    --footer-text-color: rgb(var(--color-foreground));
    --footer-text-color-subtle: rgb(var(--color-foreground) / 0.7);
    --footer-background-color: rgb(var(--color-background));
    --footer-border-color: rgb(var(--color-border));
    --footer-accent-color: rgb(var(--color-accent));

    background-color: var(--footer-background-color);
    color: var(--footer-text-color);
    padding-top: var(--footer-padding-top);
    padding-bottom: var(--footer-padding-bottom);
    border-top: 1px solid var(--footer-border-color);
    margin-top: 4rem;
  }

  .footer__container {
    max-width: var(--footer-container-max-width);
    margin: 0 auto;
    padding: 0 var(--footer-container-padding);
  }

  .footer__content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--footer-content-spacing);
    margin-bottom: var(--footer-content-spacing);
  }

  /* Layout Variations */
  .footer[data-layout-style="newsletter_prominent"] .footer__content {
    grid-template-columns: 1.5fr 1fr;
  }

  .footer[data-layout-style="centered"] .footer__content {
    text-align: center;
  }

  .footer[data-layout-style="centered"] .footer__blocks {
    justify-items: center;
  }

  /* Newsletter Section */
  .footer__newsletter {
    padding: 2.5rem;
    background: rgb(var(--color-background-2, var(--color-background)));
    border-radius: 1rem;
    border: 1px solid var(--footer-border-color);
    margin-bottom: 1rem;
    position: relative;
    overflow: hidden;
  }

  .footer__newsletter::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--footer-accent-color), rgb(var(--color-accent) / 0.6));
  }

  .footer__newsletter-heading {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--footer-text-color);
  }

  .footer__newsletter-text {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--footer-text-color-subtle);
    margin: 0 0 1.5rem;
  }

  .footer__newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer__newsletter-input-wrapper {
    display: flex;
    gap: 0.5rem;
  }

  .footer__newsletter-input {
    flex: 1;
    padding: 0.75rem 1rem;
    border: 1px solid var(--footer-border-color);
    border-radius: 0.5rem;
    background: rgb(var(--color-background));
    color: var(--footer-text-color);
    font-size: 1rem;
    transition: border-color 0.2s ease
    , box-shadow 0.2s ease;
  }

  .footer__newsletter-input:focus {
    outline: none;
    border-color: var(--footer-accent-color);
    box-shadow: 0 0 0 3px rgb(var(--color-accent) / 0.1);
  }

  .footer__newsletter-button {
    padding: 0.75rem 1.5rem;
    background: var(--footer-accent-color);
    color: rgb(var(--color-accent-foreground));
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 500;
    position: relative;
    overflow: hidden;
  }

  .footer__newsletter-button::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    background: rgb(255 255 255 / 0.2);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: width 0.6s ease
    , height 0.6s ease;
  }

  .footer__newsletter-button:hover::before {
    width: 200px;
    height: 200px;
  }

  .footer__newsletter-button:hover {
    background: rgb(var(--color-accent) / 0.9);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgb(var(--color-accent) / 0.3);
  }

  .footer__newsletter-button:active {
    transform: translateY(0);
  }

  .footer__newsletter-success,
  .footer__newsletter-error {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
  }

  .footer__newsletter-success {
    background: rgb(34 197 94 / 0.1);
    color: rgb(34 197 94);
    border: 1px solid rgb(34 197 94 / 0.2);
  }

  .footer__newsletter-error {
    background: rgb(239 68 68 / 0.1);
    color: rgb(239 68 68);
    border: 1px solid rgb(239 68 68 / 0.2);
  }

  /* Footer Blocks */
  .footer__blocks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--footer-block-spacing);
    margin-top: 2rem;
  }

  .footer__block {
    padding: 1.5rem;
    background: rgb(var(--color-background) / 0.5);
    border-radius: 0.5rem;
    transition: transform 0.2s ease
    , box-shadow 0.2s ease;
  }

  .footer__block:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgb(var(--color-foreground) / 0.1);
  }

  .footer__block-heading {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 1.5rem;
    color: var(--footer-text-color);
  }

  /* Typography Variations */
  .footer[data-heading-size="small"] .footer__block-heading,
  .footer[data-heading-size="small"] .footer__newsletter-heading {
    font-size: 1rem;
  }

  .footer[data-heading-size="large"] .footer__block-heading,
  .footer[data-heading-size="large"] .footer__newsletter-heading {
    font-size: 1.375rem;
  }

  .footer[data-text-size="small"] {
    font-size: 0.8rem;
  }

  .footer[data-text-size="large"] {
    font-size: 1.1rem;
  }

  .footer__menu-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer__menu-item {
    margin-bottom: 0;
  }

  .footer__menu-link {
    color: var(--footer-text-color-subtle);
    text-decoration: none;
    font-size: 0.875rem;
    line-height: 1.5;
    transition: color 0.2s ease;
  }

  .footer__menu-link:hover {
    color: var(--footer-text-color);
  }

  .footer__text-content {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--footer-text-color-subtle);
  }

  .footer__text-content p {
    margin: 0 0 1rem;
  }

  .footer__text-content p:last-child {
    margin-bottom: 0;
  }

  .footer__image-wrapper {
    display: flex;
  }

  .footer__image-wrapper img {
    max-width: var(--image-width, 150px);
    height: auto;
    border-radius: 0.375rem;
  }

  .footer__image[data-alignment="center"] .footer__image-wrapper {
    justify-content: center;
  }

  .footer__image[data-alignment="right"] .footer__image-wrapper {
    justify-content: flex-end;
  }

  /* Footer Bottom */
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
    padding-top: var(--footer-bottom-padding);
    padding-bottom: 1rem;
    margin-top: 2rem;
    border-top: 1px solid var(--footer-border-color);
  }

  .footer__bottom-left,
  .footer__bottom-right {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .footer__copyright {
    font-size: 0.875rem;
    color: var(--footer-text-color-subtle);
    margin-right: 1rem;
  }

  .footer__payment {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer__payment-icons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .footer__payment-icon {
    width: 32px;
    height: 20px;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .footer__payment-icon:hover {
    opacity: 1;
  }

  /* Social Icons */
  .footer__social {
    display: flex;
    gap: 0.75rem;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgb(var(--color-background-2, var(--color-background)));
    color: var(--footer-text-color-subtle);
    text-decoration: none;
    transition: all 0.2s ease;
    border: 1px solid var(--footer-border-color);
  }

  .footer__social-link:hover {
    background: var(--footer-accent-color);
    color: rgb(var(--color-accent-foreground));
    border-color: var(--footer-accent-color);
    transform: translateY(-2px);
  }

  /* Localization */
  .footer__localization {
    display: flex;
    gap: 0.75rem;
  }

  .footer__localization-form {
    margin: 0;
  }

  .footer__localization-select {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--footer-border-color);
    border-radius: 0.375rem;
    background: rgb(var(--color-background));
    color: var(--footer-text-color);
    font-size: 0.875rem;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .footer__localization-select:focus {
    outline: none;
    border-color: var(--footer-accent-color);
  }

  /* Utility Classes */
  .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  /* Responsive Design */
  @media screen and (min-width: 768px) {
    .footer__content {
      grid-template-columns: 1fr 2fr;
      align-items: start;
    }

    .footer__newsletter-form {
      flex-direction: row;
      align-items: end;
    }

    .footer__newsletter-input-wrapper {
      flex: 1;
    }

    .footer__blocks {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    }
  }

  @media screen and (max-width: 767px) {
    .footer {
      --footer-padding-top: 3rem;
      --footer-padding-bottom: 2rem;
      --footer-content-spacing: 2rem;
      --footer-block-spacing: 1.5rem;
      --footer-container-padding: 1.5rem;
    }

    .footer[data-mobile-center="true"] {
      text-align: center;
    }

    .footer[data-mobile-stack="true"] .footer__content {
      grid-template-columns: 1fr;
    }

    .footer[data-mobile-center="true"] .footer__newsletter-input-wrapper {
      justify-content: center;
    }

    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      text-align: center;
      gap: 1.5rem;
    }

    .footer[data-mobile-center="true"] .footer__bottom {
      align-items: center;
    }

    .footer__bottom-left,
    .footer__bottom-right {
      flex-direction: column;
      align-items: center;
      width: 100%;
      text-align: center;
      gap: 1rem;
    }

    .footer__blocks {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .footer[data-mobile-center="true"] .footer__blocks {
      justify-items: center;
    }

    .footer__block {
      padding: 1.25rem;
    }

    .footer__newsletter {
      padding: 2rem;
    }

    .footer__newsletter-input-wrapper {
      flex-direction: column;
    }

    .footer__social {
      justify-content: center;
    }

    .footer__localization {
      justify-content: center;
      flex-direction: column;
      align-items: center;
    }

    .footer__image-wrapper {
      justify-content: center;
    }
  }

  @media screen and (max-width: 480px) {
    .footer {
      --footer-container-padding: 1rem;
    }

    .footer__payment-icons {
      justify-content: center;
    }
  }

  /* Color Scheme Variations */
  .footer[data-color-scheme="accent"] {
    --footer-background-color: rgb(var(--color-accent));
    --footer-text-color: rgb(var(--color-accent-foreground));
    --footer-text-color-subtle: rgb(var(--color-accent-foreground) / 0.8);
    --footer-border-color: rgb(var(--color-accent-foreground) / 0.1);
  }

  .footer[data-color-scheme="inverse"] {
    --footer-background-color: rgb(var(--color-foreground));
    --footer-text-color: rgb(var(--color-background));
    --footer-text-color-subtle: rgb(var(--color-background) / 0.8);
    --footer-border-color: rgb(var(--color-background) / 0.1);
  }

  .footer[data-color-scheme="background-2"] {
    --footer-background-color: rgb(var(--color-background-2));
  }
{% endstylesheet %}

