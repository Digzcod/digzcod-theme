{% stylesheet %}
  .collection-hero {
    --text-color-light: #ffffff;
    --text-color-dark: #111827;
    --button-bg-light: #ffffff;
    --button-text-light: #111827;
    --button-bg-dark: #111827;
    --button-text-dark: #ffffff;

    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--hero-height, 480px);
    overflow: hidden;
    background-color: #f3f4f6;
  }

  .collection-hero__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background-size: cover;
    background-repeat: no-repeat;
    background-position: var(--image-position, center);
  }

  .collection-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(0, 0, 0, var(--overlay-opacity, 0.3)) 0%, rgba(0, 0, 0, calc(var(--overlay-opacity, 0.3) * 0.8)) 100%);
    z-index: 2;
  }

  .collection-hero__content {
    position: relative;
    width: 100%;
    z-index: 3;
    padding: 2rem 0;
  }

  .collection-hero__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    text-align: center;
  }

  .collection-hero--left .collection-hero__container {
    text-align: left;
  }

  .collection-hero--right .collection-hero__container {
    text-align: right;
  }

  .collection-hero__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 1rem;
    max-width: 800px;
  }

  .collection-hero--left .collection-hero__title {
    margin-left: 0;
    margin-right: auto;
  }

  .collection-hero--center .collection-hero__title {
    margin-left: auto;
    margin-right: auto;
  }

  .collection-hero--right .collection-hero__title {
    margin-left: auto;
    margin-right: 0;
  }

  .collection-hero__subtitle {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    line-height: 1.5;
    margin: 0 0 2rem;
    max-width: 600px;
    opacity: 0.9;
  }

  .collection-hero--left .collection-hero__subtitle {
    margin-left: 0;
    margin-right: auto;
  }

  .collection-hero--center .collection-hero__subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .collection-hero--right .collection-hero__subtitle {
    margin-left: auto;
    margin-right: 0;
  }

  .collection-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 2rem;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.3s ease;
    min-width: 160px;
    border: 2px solid transparent;
  }

  /* Button Style Variants */
  .collection-hero__button--filled {
    background-color: #000000;
    color: #ffffff;
    border: 2px solid #000000;
  }

  .collection-hero__button--filled:hover {
    background-color: transparent;
    color: #000000;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
  }

  .collection-hero__button--outlined {
    background-color: transparent;
    color: #000000;
    border: 2px solid #000000;
  }

  .collection-hero__button--outlined:hover {
    background-color: #000000;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
  }

  .collection-hero__button--text {
    background-color: transparent;
    color: #000000;
    border: none;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .collection-hero__button--text:hover {
    color: #666666;
    transform: translateY(-1px);
    text-decoration: none;
  }

  .collection-hero--light .collection-hero__title,
  .collection-hero--light .collection-hero__subtitle {
    color: var(--text-color-light);
  }

  .collection-hero--light .collection-hero__button {
    background-color: var(--button-bg-light);
    color: var(--button-text-light);
    border-color: var(--button-bg-light);
  }

  .collection-hero--light .collection-hero__button:hover {
    background-color: transparent;
    color: var(--text-color-light);
    border-color: var(--button-bg-light);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(255, 255, 255, 0.2);
  }

  .collection-hero--dark .collection-hero__title,
  .collection-hero--dark .collection-hero__subtitle {
    color: var(--text-color-dark);
  }

  .collection-hero--dark .collection-hero__button {
    background-color: var(--button-bg-dark);
    color: var(--button-text-dark);
    border-color: var(--button-bg-dark);
  }

  .collection-hero--dark .collection-hero__button:hover {
    background-color: transparent;
    color: var(--text-color-dark);
    border-color: var(--button-bg-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
  }

  @media screen and (max-width: 768px) {
    .collection-hero {
      min-height: calc(var(--hero-height, 480px) * 0.8);
    }

    .collection-hero__content {
      padding: 1.5rem 0;
    }

    .collection-hero__container {
      padding: 0 1rem;
    }

    .collection-hero__title {
      margin-bottom: 0.75rem;
    }

    .collection-hero__subtitle {
      margin-bottom: 1.5rem;
    }

    .collection-hero__button {
      padding: 0.875rem 1.5rem;
      font-size: 0.875rem;
      min-width: 140px;
    }
  }

  @media screen and (max-width: 480px) {
    .collection-hero {
      min-height: calc(var(--hero-height, 480px) * 0.7);
    }

    .collection-hero__title {
      font-size: 1.75rem;
    }

    .collection-hero__subtitle {
      font-size: 1rem;
    }
  }
{% endstylesheet %}