{% comment %} 
          Dynamic Hero Banner for Collection Pages
          Supports theme editor settings with metafield fallbacks 
{% endcomment %}

{%- liquid
  # Dynamic content logic with metafield fallbacks
  assign hero_image = section.settings.hero_image
  assign hero_title = section.settings.hero_title
  assign hero_subtitle = section.settings.hero_subtitle
  assign hero_button_label = section.settings.hero_button_label
  assign hero_button_link = section.settings.hero_button_link

  # Use collection metafields as fallbacks if settings are empty
  if template.name == 'collection' and collection
    if hero_image == blank and collection.metafields.custom.hero_image != blank
      assign hero_image = collection.metafields.custom.hero_image
    endif

    if hero_title == blank and collection.metafields.custom.hero_title != blank
      assign hero_title = collection.metafields.custom.hero_title
    elsif hero_title == blank
      assign hero_title = collection.title
    endif

    if hero_subtitle == blank and collection.metafields.custom.hero_subtitle != blank
      assign hero_subtitle = collection.metafields.custom.hero_subtitle
    elsif hero_subtitle == blank
      assign hero_subtitle = collection.description
    endif

    if hero_button_label == blank and collection.metafields.custom.hero_button_label != blank
      assign hero_button_label = collection.metafields.custom.hero_button_label
    endif

    if hero_button_link == blank and collection.metafields.custom.hero_button_link != blank
      assign hero_button_link = collection.metafields.custom.hero_button_link
    endif
  endif

  # Final fallbacks
  if hero_title == blank
    assign hero_title = 'general.collection_hero.default_title' | t
  endif

  if hero_button_label == blank
    assign hero_button_label = 'general.collection_hero.default_button' | t
  endif

  if hero_button_link == blank
    assign hero_button_link = routes.collections_url
  endif

  # CSS variables
  assign section_id = 'CollectionHero-' | append: section.id
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign hero_height = section.settings.hero_height | append: 'px'
  assign image_position = section.settings.image_position | default: 'center'

  # Typography variables
  assign heading_font_size = section.settings.heading_font_size | append: 'px'
  assign heading_font_weight = section.settings.heading_font_weight
  assign heading_font_style = section.settings.heading_font_style
  assign heading_color = section.settings.heading_color_custom
  assign subtitle_font_size = section.settings.subtitle_font_size | append: 'px'
  assign subtitle_font_weight = section.settings.subtitle_font_weight
  assign subtitle_color = section.settings.subtitle_color_custom

  # Button variables
  assign button_style = section.settings.button_style
  assign button_bg_color = section.settings.button_bg_color
  assign button_text_color = section.settings.button_text_color
  assign button_border_color = section.settings.button_border_color | default: button_bg_color
  assign button_font_size = section.settings.button_font_size | append: 'px'
  assign button_font_weight = section.settings.button_font_weight
  assign button_border_radius = section.settings.button_border_radius | append: 'px'
-%}

<section
  id="{{ section_id }}"
  class="collection-hero collection-hero--{{ section.settings.content_alignment }} collection-hero--{{ section.settings.text_color }}"
  style="--hero-height: {{ hero_height }}; --overlay-opacity: {{ overlay_opacity }}; --image-position: {{ image_position }};">
  {%- if hero_image != blank -%}
    <div
      class="collection-hero__image"
      style="background-image: url('{{ hero_image | image_url: width: 1920 }}');"
      role="img"
      aria-label="{{ hero_image.alt | default: hero_title }}"></div>
  {%- endif -%}

  {%- if section.settings.overlay_opacity > 0 -%}
    <div class="collection-hero__overlay"></div>
  {%- endif -%}

  <div class="collection-hero__content">
    <div class="collection-hero__container">
      {%- if hero_title != blank -%}
        <h1 class="collection-hero__title" style="
          {%- if heading_font_size != blank -%}font-size: {{ heading_font_size }};{%- endif -%}
          {%- if heading_font_weight != blank -%}font-weight: {{ heading_font_weight }};{%- endif -%}
          {%- if heading_font_style != blank -%}font-style: {{ heading_font_style }};{%- endif -%}
          {%- if heading_color != blank -%}color: {{ heading_color }} !important;{%- endif -%}
        ">
          {{ hero_title }}</h1>
      {%- endif -%}

      {%- if hero_subtitle != blank -%}
        <div class="collection-hero__subtitle" style="
          {%- if subtitle_font_size != blank -%}font-size: {{ subtitle_font_size }};{%- endif -%}
          {%- if subtitle_font_weight != blank -%}font-weight: {{ subtitle_font_weight }};{%- endif -%}
          {%- if subtitle_color != blank -%}color: {{ subtitle_color }} !important;{%- endif -%}
        ">
          {{ hero_subtitle }}</div>
      {%- endif -%}

      {%- if hero_button_label != blank and hero_button_link != blank -%}
        <a
          href="{{ hero_button_link }}"
          class="collection-hero__button collection-hero__button--{{ button_style }}"
          style="
          {%- if button_bg_color != blank and button_style == 'filled' -%}background-color: {{ button_bg_color }};{%- endif -%}
          {%- if button_text_color != blank -%}color: {{ button_text_color }};{%- endif -%}
          {%- if button_border_color != blank and button_style == 'outlined' -%}border-color: {{ button_border_color }};{%- endif -%}
          {%- if button_font_size != blank -%}font-size: {{ button_font_size }};{%- endif -%}
          {%- if button_font_weight != blank -%}font-weight: {{ button_font_weight }};{%- endif -%}
          {%- if button_border_radius != blank -%}border-radius: {{ button_border_radius }};{%- endif -%}
        ">
          {{ hero_button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

