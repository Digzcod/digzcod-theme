{% comment %} 
  Collection Cards Section
  Dynamic collection cards with responsive grid layout and merchant customization options
  Features: Auto-responsive 4-column max grid, add new card functionality, individual card editing 
{% endcomment %}

{%- liquid
  assign section_id = 'CollectionCards-' | append: section.id
-%}

{% stylesheet %}
  .collection-cards {
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
    background-color: var(--section-bg-color, #ffffff);
  }

  .collection-cards__container {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 var(--section-horizontal-padding, 20px);
  }

  .collection-cards__header {
    text-align: var(--header-alignment, center);
    margin-bottom: var(--header-spacing, 40px);
  }

  .collection-cards__title {
    font-size: var(--title-font-size, 2.5rem);
    font-weight: var(--title-font-weight, 700);
    color: var(--title-color, #1a1a1a);
    margin: 0 0 var(--title-margin-bottom, 16px);
    line-height: 1.2;
  }

  .collection-cards__subtitle {
    font-size: var(--subtitle-font-size, 1.125rem);
    color: var(--subtitle-color, #666);
    margin: 0 auto;
    max-width: 600px;
  }

  .collection-cards__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--grid-gap, 24px);
    max-width: 100%;
  }

  @media (min-width: 768px) {
    .collection-cards__grid {
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--grid-gap-desktop, 32px);
    }
  }

  @media (min-width: 1200px) {
    .collection-cards__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .collection-card {
    background: var(--card-bg-color, #ffffff);
    border-radius: var(--card-border-radius, 12px);
    overflow: hidden;
    box-shadow: var(--card-shadow, 0 4px 6px -1px rgba(0, 0, 0, 0.1));
    transition: all 0.3s ease;
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .collection-card:hover {
    transform: translateY(var(--card-hover-lift, -4px));
    box-shadow: var(--card-hover-shadow, 0 10px 25px -3px rgba(0, 0, 0, 0.15));
  }

  .collection-card__image-wrapper {
    position: relative;
    aspect-ratio: var(--card-image-ratio, 4 / 3);
    overflow: hidden;
  }

  .collection-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .collection-card:hover .collection-card__image {
    transform: scale(1.05);
  }

  .collection-card__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.3) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .collection-card:hover .collection-card__overlay {
    opacity: 1;
  }

  .collection-card__content {
    padding: var(--card-content-padding, 24px);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .collection-card__title {
    font-size: var(--card-title-size, 1.25rem);
    font-weight: var(--card-title-weight, 600);
    color: var(--card-title-color, #1a1a1a);
    margin: 0 0 var(--card-title-spacing, 12px);
    line-height: 1.3;
  }

  .collection-card__description {
    font-size: var(--card-description-size, 0.9rem);
    color: var(--card-description-color, #666);
    margin: 0 0 var(--card-description-spacing, 20px);
    line-height: 1.5;
    flex-grow: 1;
  }

  .collection-card__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--button-padding, 12px 24px);
    background-color: var(--button-bg-color, #000000);
    color: var(--button-text-color, #ffffff);
    text-decoration: none;
    border-radius: var(--button-border-radius, 8px);
    font-size: var(--button-font-size, 0.9rem);
    font-weight: var(--button-font-weight, 500);
    transition: all 0.3s ease;
    border: 2px solid var(--button-bg-color, #000000);
    align-self: flex-start;
  }

  .collection-card__button:hover {
    background-color: var(--button-hover-bg, transparent);
    color: var(--button-hover-text, #000000);
    border-color: var(--button-bg-color, #000000);
  }

  @media (max-width: 767px) {
    .collection-cards__grid {
      grid-template-columns: 1fr;
    }

    .collection-cards__title {
      font-size: var(--title-font-size-mobile, 2rem);
    }

    .collection-card__content {
      padding: var(--card-content-padding-mobile, 20px);
    }
  }
{% endstylesheet %}

<div class="collection-cards" id="{{ section_id }}">
  <div class="collection-cards__container">

    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="collection-cards__header">
        {%- if section.settings.title != blank -%}
          <h2 class="collection-cards__title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <div class="collection-cards__subtitle">{{ section.settings.subtitle }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="collection-cards__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection_handle = block.settings.collection_handle
          assign collection_url = '/collections/' | append: collection_handle
          if collection_handle == blank
            assign collection_url = block.settings.custom_url | default: '/collections'
          endif
        -%}

        <div class="collection-card" {{ block.shopify_attributes }}>
          <a href="{{ collection_url }}" class="collection-card__image-wrapper">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                alt="{{ block.settings.image.alt | default: block.settings.title }}"
                class="collection-card__image"
                loading="lazy"
                width="600"
                height="{{ 600 | divided_by: block.settings.image.aspect_ratio | round }}">
            {%- else -%}
              <div class="collection-card__image" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"></div>
            {%- endif -%}
            <div class="collection-card__overlay"></div>
          </a>

          <div class="collection-card__content">
            {%- if block.settings.title != blank -%}
              <h3 class="collection-card__title">{{ block.settings.title }}</h3>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <p class="collection-card__description">{{ block.settings.description }}</p>
            {%- endif -%}

            <a href="{{ collection_url }}" class="collection-card__button">
              {{ block.settings.button_text | default: 'See More' }}
            </a>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% style %}
  #{{ section_id }}
{
  --section-padding-top: {{ section.settings.padding_top | default: 64 }}px;
  --section-padding-bottom: {{ section.settings.padding_bottom | default: 64 }}px;
  --section-bg-color: {{ section.settings.background_color | default: '#ffffff' }};
  --section-horizontal-padding: {{ section.settings.horizontal_padding | default: 20 }}px;

  --header-alignment: {{ section.settings.header_alignment | default: 'center' }};
  --header-spacing: {{ section.settings.header_spacing | default: 40 }}px;

  --title-font-size: {{ section.settings.title_font_size | default: 40 }}px;
  --title-font-size-mobile: {{ section.settings.title_font_size | default: 40 | times: 0.8 }}px;
  --title-font-weight: {{ section.settings.title_font_weight | default: 700 }};
  --title-color: {{ section.settings.title_color | default: '#1a1a1a' }};
  --title-margin-bottom: {{ section.settings.title_spacing | default: 16 }}px;

  --subtitle-font-size: {{ section.settings.subtitle_font_size | default: 18 }}px;
  --subtitle-color: {{ section.settings.subtitle_color | default: '#666666' }};

  --grid-gap: {{ section.settings.grid_gap_mobile | default: 24 }}px;
  --grid-gap-desktop: {{ section.settings.grid_gap_desktop | default: 32 }}px;

  --card-bg-color: {{ section.settings.card_background_color | default: '#ffffff' }};
  --card-border-radius: {{ section.settings.card_border_radius | default: 12 }}px;
  --card-shadow: {{ section.settings.card_shadow_style | default: '0 4px 6px -1px rgba(0, 0, 0, 0.1)' }};
  --card-hover-shadow: {{ section.settings.card_hover_shadow | default: '0 10px 25px -3px rgba(0, 0, 0, 0.15)' }};
  --card-hover-lift: {{ section.settings.card_hover_lift | default: -4 }}px;
  --card-image-ratio: {{ section.settings.card_image_ratio | default: '4/3' }};

  --card-content-padding: {{ section.settings.card_content_padding | default: 24 }}px;
  --card-content-padding-mobile: {{ section.settings.card_content_padding | default: 24 | times: 0.83 }}px;

  --card-title-size: {{ section.settings.card_title_font_size | default: 20 }}px;
  --card-title-weight: {{ section.settings.card_title_font_weight | default: 600 }};
  --card-title-color: {{ section.settings.card_title_color | default: '#1a1a1a' }};
  --card-title-spacing: {{ section.settings.card_title_spacing | default: 12 }}px;

  --card-description-size: {{ section.settings.card_description_font_size | default: 14 }}px;
  --card-description-color: {{ section.settings.card_description_color | default: '#666666' }};
  --card-description-spacing: {{ section.settings.card_description_spacing | default: 20 }}px;

  --button-padding: {{ section.settings.button_padding_vertical | default: 12 }}px{{ section.settings.button_padding_horizontal | default: 24 }}px;
  --button-bg-color: {{ section.settings.button_background_color | default: '#000000' }};
  --button-text-color: {{ section.settings.button_text_color | default: '#ffffff' }};
  --button-hover-bg: {{ section.settings.button_hover_background | default: 'transparent' }};
  --button-hover-text: {{ section.settings.button_hover_text_color | default: '#000000' }};
  --button-border-radius: {{ section.settings.button_border_radius | default: 8 }}px;
  --button-font-size: {{ section.settings.button_font_size | default: 14 }}px;
  --button-font-weight: {{ section.settings.button_font_weight | default: 500 }};
}
{% endstyle %}

