{%- liquid
  assign section_id = 'TrustIcons-' | append: section.id
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign icon_size = section.settings.icon_size
  assign layout = section.settings.layout
  assign color_scheme = section.settings.color_scheme
-%}

<section
  id="{{ section_id }}"
  class="trust-icons section-{{ section.id }}"
  data-color-scheme="{{ color_scheme }}">
  <div class="trust-icons__container">
    {%- if heading != blank or subheading != blank -%}
      <div class="trust-icons__header">
        {%- if heading != blank -%}
          <h2 class="trust-icons__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="trust-icons__subheading">{{ subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="trust-icons__grid trust-icons__grid--{{ layout }}" style="--icon-size: {{ icon_size }}px;">
        {%- for block in section.blocks -%}
          {%- liquid
            assign icon = block.settings.icon
            assign title = block.settings.title
            assign description = block.settings.description
            assign block_id = 'TrustIcon-' | append: block.id
          -%}

          <div
            class="trust-icon"
            id="{{ block_id }}"
            {{ block.shopify_attributes }}>
            {%- if icon != blank -%}
              <div class="trust-icon__icon" aria-hidden="true">
                {%- case icon -%}
                  {%- when 'truck' -%}
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round">
                      <path d="M14 18V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2" />
                      <path d="M15 18H9" />
                      <path d="M19 18h2a1 1 0 0 0 1-1v-3.28a1 1 0 0 0-.684-.948l-1.923-.641a1 1 0 0 1-.578-.502l-1.539-3.076A1 1 0 0 0 16.382 8H14" />
                      <circle
                        cx="17"
                        cy="18"
                        r="2" />
                      <circle
                        cx="7"
                        cy="18"
                        r="2" />
                    </svg>
                  {%- when 'leaf' -%}
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round">
                      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" />
                      <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" />
                    </svg>
                  {%- when 'users' -%}
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round">
                      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                      <circle
                        cx="9"
                        cy="7"
                        r="4" />
                      <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                      <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                  {%- when 'shield-check' -%}
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round">
                      <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
                      <path d="M9 12l2 2 4-4" />
                    </svg>
                  {%- when 'heart' -%}
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round">
                      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z" />
                    </svg>
                  {%- when 'award' -%}
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round">
                      <circle
                        cx="12"
                        cy="8"
                        r="6" />
                      <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" />
                    </svg>
                  {%- when 'recycle' -%}
                    <svg
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round">
                      <path d="M7 19H4.815a1.83 1.83 0 0 1-1.57-.881 1.785 1.785 0 0 1-.004-1.784L7.196 9.5" />
                      <path d="M11 19h8.203a1.83 1.83 0 0 0 1.556-.89 1.784 1.784 0 0 0 0-1.775l-1.226-2.12" />
                      <path d="M14 16.5 11.25 9.5" />
                      <path d="M8.111 9.5 5.25 16.5" />
                      <path d="M3 3.5c0-.83.671-1.5 1.5-1.5S6 2.67 6 3.5 5.329 5 4.5 5 3 4.33 3 3.5Z" />
                      <path d="M6.5 17.5c0-.83.671-1.5 1.5-1.5s1.5.67 1.5 1.5S8.829 19 8 19s-1.5-.67-1.5-1.5Z" />
                      <path d="M16.5 17.5c0-.83.671-1.5 1.5-1.5s1.5.67 1.5 1.5-.671 1.5-1.5 1.5-1.5-.67-1.5-1.5Z" />
                    </svg>
                {%- endcase -%}
              </div>
            {%- endif -%}

            <div class="trust-icon__content">
              {%- if title != blank -%}
                <h3 class="trust-icon__title">{{ title }}</h3>
              {%- endif -%}
              {%- if description != blank -%}
                <p class="trust-icon__description">{{ description }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .trust-icons {
    --section-padding-top: 3rem;
    --section-padding-bottom: 3rem;
    --container-max-width: 1200px;
    --container-padding: 1rem;
    --icon-size: 48px;
    --gap: 2rem;
    --text-color: rgb(var(--color-foreground));
    --text-color-subtle: rgb(var(--color-foreground) / 0.7);
    --background-color: rgb(var(--color-background));
    --border-color: rgb(var(--color-border));

    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
    background-color: var(--background-color);
    color: var(--text-color);
  }

  .trust-icons__container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .trust-icons__header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .trust-icons__heading {
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.2;
    margin: 0 0 0.5rem;
    color: var(--text-color);
  }

  .trust-icons__subheading {
    font-size: 1.125rem;
    line-height: 1.5;
    margin: 0;
    color: var(--text-color-subtle);
  }

  .trust-icons__grid {
    display: grid;
    gap: var(--gap);
    align-items: start;
  }

  .trust-icons__grid--columns {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  .trust-icons__grid--row {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .trust-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.5rem;
    transition: transform 0.2s ease;
  }

  .trust-icons__grid--row .trust-icon {
    flex-direction: row;
    text-align: left;
    align-items: flex-start;
  }

  .trust-icon:hover {
    transform: translateY(-2px);
  }

  .trust-icon__icon {
    flex-shrink: 0;
    width: var(--icon-size);
    height: var(--icon-size);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    color: rgb(var(--color-foreground));
  }

  .trust-icons__grid--row .trust-icon__icon {
    margin-bottom: 0;
    margin-right: 1rem;
  }

  .trust-icon__icon svg {
    width: 100%;
    height: 100%;
  }

  .trust-icon__content {
    flex: 1;
  }

  .trust-icon__title {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 0.5rem;
    color: var(--text-color);
  }

  .trust-icon__description {
    font-size: 0.875rem;
    line-height: 1.4;
    margin: 0;
    color: var(--text-color-subtle);
  }

  /* Mobile adjustments */
  @media screen and (max-width: 768px) {
    .trust-icons {
      --section-padding-top: 2rem;
      --section-padding-bottom: 2rem;
      --gap: 1.5rem;
    }

    .trust-icons__heading {
      font-size: 1.5rem;
    }

    .trust-icons__subheading {
      font-size: 1rem;
    }

    .trust-icons__grid--row .trust-icon {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }

    .trust-icons__grid--row .trust-icon__icon {
      margin-bottom: 1rem;
      margin-right: 0;
    }

    .trust-icons__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Small screens - stack everything */
  @media screen and (max-width: 480px) {
    .trust-icons {
      --container-padding: 1rem;
      --gap: 1rem;
    }

    .trust-icon {
      padding: 1rem;
    }
  }

  /* Color scheme variations */
  .trust-icons[data-color-scheme="accent"] {
    --background-color: rgb(var(--color-accent));
    --text-color: rgb(var(--color-accent-foreground));
    --text-color-subtle: rgb(var(--color-accent-foreground) / 0.8);
  }

  .trust-icons[data-color-scheme="inverse"] {
    --background-color: rgb(var(--color-foreground));
    --text-color: rgb(var(--color-background));
    --text-color-subtle: rgb(var(--color-background) / 0.8);
  }
{% endstylesheet %}

