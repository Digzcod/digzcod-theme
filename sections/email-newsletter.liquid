{%- liquid
  assign section_id = 'Newsletter-' | append: section.id
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign discount_text = section.settings.discount_text
  assign placeholder_text = section.settings.placeholder_text | default: 'Enter your email'
  assign button_text = section.settings.button_text | default: 'Subscribe'
  assign success_message = section.settings.success_message
  assign privacy_text = section.settings.privacy_text
  assign layout_style = section.settings.layout_style
  assign color_scheme = section.settings.color_scheme
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign content_width = section.settings.content_width
  assign content_alignment = section.settings.content_alignment
  assign form_width = section.settings.form_width
  assign input_style = section.settings.input_style
  assign button_style = section.settings.button_style
  assign enable_background_image = section.settings.enable_background_image
  assign background_image = section.settings.background_image
  assign overlay_opacity = section.settings.overlay_opacity
-%}

{% stylesheet %}
  .newsletter {
    padding-top: var(--newsletter-padding-top, 4rem);
    padding-bottom: var(--newsletter-padding-bottom, 4rem);
    position: relative;
    overflow: hidden;
  }

  .newsletter[data-color-scheme="1"] {
    background-color: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.87);
  }

  .newsletter[data-color-scheme="2"] {
    background-color: rgb(var(--color-accent-1));
    color: rgba(var(--color-accent-1-text), 0.87);
  }

  .newsletter[data-color-scheme="3"] {
    background-color: rgb(var(--color-accent-2));
    color: rgba(var(--color-accent-2-text), 0.87);
  }

  .newsletter[data-color-scheme="inverse"] {
    background-color: rgba(var(--color-foreground), 1);
    color: rgba(var(--color-background), 1);
  }

  .newsletter__background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .newsletter__background-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .newsletter__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, var(--newsletter-overlay-opacity, 0.5));
    z-index: 2;
  }

  .newsletter__container {
    max-width: var(--newsletter-content-width, 80rem);
    margin: 0 auto;
    padding: 0 var(--page-padding, 1.5rem);
    position: relative;
    z-index: 3;
  }

  .newsletter__content {
    text-align: var(--newsletter-content-alignment, center);
  }

  .newsletter__content[data-layout="split"] {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    text-align: left;
  }

  .newsletter__text-content {
    max-width: 60ch;
    margin: 0 auto;
  }

  .newsletter__content[data-layout="split"] .newsletter__text-content {
    margin: 0;
  }

  .newsletter__discount {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: linear-gradient(135deg, rgba(var(--color-accent-1), 0.1), rgba(var(--color-accent-1), 0.2));
    border: 1px solid rgba(var(--color-accent-1), 0.3);
    border-radius: var(--border-radius-pill, 9999px);
    font-size: var(--font-size-sm, 0.875rem);
    font-weight: var(--font-weight-medium, 500);
    color: rgba(var(--color-accent-1), 1);
    margin-bottom: 1.5rem;
  }

  .newsletter__discount-icon {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }

  .newsletter__heading {
    margin: 0 0 1rem;
    font-size: var(--font-size-h2, 2.5rem);
    font-weight: var(--font-weight-bold, 700);
    line-height: var(--line-height-tight, 1.2);
    letter-spacing: var(--letter-spacing-tight, -0.025em);
  }

  .newsletter__subheading {
    margin: 0 0 2rem;
    font-size: var(--font-size-lg, 1.125rem);
    line-height: var(--line-height-relaxed, 1.625);
    opacity: 0.8;
  }

  .newsletter__form-wrapper {
    max-width: var(--newsletter-form-width, 100%);
    margin: 0 auto;
  }

  .newsletter__content[data-layout="split"] .newsletter__form-wrapper {
    margin: 0;
  }

  .newsletter__form {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .newsletter__form[data-input-style="stacked"] {
    flex-direction: column;
    gap: 1rem;
  }

  .newsletter__input {
    flex: 1;
    padding: 1rem 1.25rem;
    border: 2px solid rgba(var(--color-border), 0.2);
    border-radius: var(--border-radius-button, 0.5rem);
    background-color: rgba(var(--color-background), 0.8);
    color: rgba(var(--color-foreground), 1);
    font-size: var(--font-size-base, 1rem);
    transition: var(--transition-colors, border-color 0.2s ease, box-shadow 0.2s ease);
    backdrop-filter: blur(10px);
  }

  .newsletter__input:focus {
    outline: none;
    border-color: rgba(var(--color-accent-1), 1);
    box-shadow: 0 0 0 3px rgba(var(--color-accent-1), 0.1);
  }

  .newsletter__input::placeholder {
    color: rgba(var(--color-foreground), 0.6);
  }

  .newsletter__input[data-style="minimal"] {
    border: none;
    border-bottom: 2px solid rgba(var(--color-border), 0.3);
    border-radius: 0;
    background-color: transparent;
    padding: 1rem 0;
  }

  .newsletter__input[data-style="pill"] {
    border-radius: var(--border-radius-pill, 9999px);
    padding: 1rem 1.5rem;
  }

  .newsletter__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    background-color: rgba(var(--color-accent-1), 1);
    color: rgba(var(--color-accent-1-text), 1);
    border: none;
    border-radius: var(--border-radius-button, 0.5rem);
    font-size: var(--font-size-base, 1rem);
    font-weight: var(--font-weight-medium, 500);
    cursor: pointer;
    transition: var(--transition-colors, background-color 0.2s ease, transform 0.2s ease);
    white-space: nowrap;
    min-width: 120px;
  }

  .newsletter__button:hover {
    background-color: rgba(var(--color-accent-1), 0.9);
    transform: translateY(-1px);
  }

  .newsletter__button[data-style="outline"] {
    background-color: transparent;
    border: 2px solid rgba(var(--color-accent-1), 1);
    color: rgba(var(--color-accent-1), 1);
  }

  .newsletter__button[data-style="outline"]:hover {
    background-color: rgba(var(--color-accent-1), 1);
    color: rgba(var(--color-accent-1-text), 1);
  }

  .newsletter__button[data-style="pill"] {
    border-radius: var(--border-radius-pill, 9999px);
    padding: 1rem 2rem;
  }

  .newsletter__button[data-style="gradient"] {
    background: linear-gradient(135deg, rgba(var(--color-accent-1), 1), rgba(var(--color-accent-2), 1));
    border: none;
    color: white;
  }

  .newsletter__button[data-style="gradient"]:hover {
    background: linear-gradient(135deg, rgba(var(--color-accent-1), 0.9), rgba(var(--color-accent-2), 0.9));
  }

  .newsletter__button-icon {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }

  .newsletter__privacy {
    font-size: var(--font-size-xs, 0.75rem);
    opacity: 0.7;
    line-height: var(--line-height-relaxed, 1.625);
  }

  .newsletter__privacy a {
    color: inherit;
    text-decoration: underline;
  }

  .newsletter__success {
    display: none;
    padding: 1rem;
    background-color: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: var(--border-radius-button, 0.5rem);
    color: rgba(34, 197, 94, 1);
    font-size: var(--font-size-sm, 0.875rem);
    text-align: center;
    margin-top: 1rem;
  }

  .newsletter__success.active {
    display: block;
  }

  .newsletter__success-icon {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
    margin-right: 0.5rem;
    vertical-align: middle;
  }

  /* Mobile styles */
  @media screen and (max-width: 749px) {
    .newsletter__content[data-layout="split"] {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }

    .newsletter__form {
      flex-direction: column;
      gap: 1rem;
    }

    .newsletter__heading {
      font-size: var(--font-size-xl, 1.25rem);
    }

    .newsletter__input,
    .newsletter__button {
      padding: 0.875rem 1.25rem;
    }

    .newsletter__discount {
      font-size: var(--font-size-xs, 0.75rem);
      padding: 0.375rem 0.75rem;
    }
  }

  @media screen and (min-width: 750px) and(max-width: 989px) {
    .newsletter__content[data-layout="split"] {
      gap: 2rem;
    }

    .newsletter__form[data-input-style="inline"] {
      gap: 0.5rem;
    }
  }
{% endstylesheet %}

<section
  id="{{ section_id }}"
  class="newsletter section-{{ section.id }}"
  data-color-scheme="{{ color_scheme }}"
  style="
    --newsletter-padding-top: {{ padding_top }}rem;
    --newsletter-padding-bottom: {{ padding_bottom }}rem;
    --newsletter-content-width: {{ content_width }}rem;
    --newsletter-content-alignment: {{ content_alignment }};
    --newsletter-form-width: {{ form_width }}%;
    --newsletter-overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }};
  "
  aria-labelledby="Newsletter-heading-{{ section.id }}">

  {%- if enable_background_image and background_image -%}
    <div class="newsletter__background">
      <img
        src="{{ background_image | image_url: width: 1920 }}"
        alt=""
        class="newsletter__background-image"
        loading="lazy"
        width="1920"
        height="1080"
        sizes="100vw"
        srcset="{{ background_image | image_url: width: 600 }} 600w, {{ background_image | image_url: width: 900 }} 900w, {{ background_image | image_url: width: 1200 }} 1200w, {{ background_image | image_url: width: 1500 }} 1500w, {{ background_image | image_url: width: 1920 }} 1920w">
      <div class="newsletter__overlay"></div>
    </div>
  {%- endif -%}

  <div class="newsletter__container">
    <div class="newsletter__content" data-layout="{{ layout_style }}">
      <div class="newsletter__text-content">
        {%- if discount_text != blank -%}
          <div class="newsletter__discount">
            <svg
              class="newsletter__discount-icon"
              viewBox="0 0 24 24"
              fill="currentColor">
              <path d="M12 2C13.1 2 14 2.9 14 4C14 5.1 13.1 6 12 6C10.9 6 10 5.1 10 4C10 2.9 10.9 2 12 2ZM21 9V7L15 1H5C3.9 1 3 1.9 3 3V19C3 20.1 3.9 21 5 21H11V19H5V3H13V7C13 8.1 13.9 9 15 9H21ZM20.3 18.7L22 17L18 13L16.3 14.7L17.6 16H14V18H17.6L16.3 19.3L18 21L22 17Z" />
            </svg>
            {{ discount_text }}
          </div>
        {%- endif -%}

        {%- if heading != blank -%}
          <h2 id="Newsletter-heading-{{ section.id }}" class="newsletter__heading">
            {{ heading }}
          </h2>
        {%- endif -%}

        {%- if subheading != blank -%}
          <div class="newsletter__subheading rte">
            {{ subheading }}
          </div>
        {%- endif -%}
      </div>

      <div class="newsletter__form-wrapper">
        <form
          class="newsletter__form"
          data-input-style="{{ input_style }}"
          action="{{ routes.newsletters_url }}"
          method="post"
          accept-charset="UTF-8"
          data-newsletter-form>
          <input
            type="hidden"
            name="form_type"
            value="customer">
          <input
            type="hidden"
            name="utf8"
            value="✓">
          <input
            type="hidden"
            name="contact[tags]"
            value="newsletter">

          <input
            type="email"
            name="contact[email]"
            class="newsletter__input"
            data-style="{{ input_style }}"
            placeholder="{{ placeholder_text }}"
            aria-label="Email address"
            required
            autocomplete="email">

          <button
            type="submit"
            class="newsletter__button"
            data-style="{{ button_style }}"
            aria-label="Subscribe to newsletter">
            {{ button_text }}
            <svg
              class="newsletter__button-icon"
              viewBox="0 0 24 24"
              fill="currentColor">
              <path d="M2,21L23,12L2,3V10L17,12L2,14V21Z" />
            </svg>
          </button>
        </form>

        <div class="newsletter__success" data-success-message>
          <svg
            class="newsletter__success-icon"
            viewBox="0 0 24 24"
            fill="currentColor">
            <path d="M9,20.42L2.79,14.21L5.62,11.38L9,14.77L18.88,4.88L21.71,7.71L9,20.42Z" />
          </svg>
          {{ success_message | default: 'Thanks for subscribing!' }}
        </div>

        {%- if privacy_text != blank -%}
          <div class="newsletter__privacy rte">
            {{ privacy_text }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  class NewsletterForm {
    constructor() {
      this.form = document.querySelector('[data-newsletter-form]');
      this.successMessage = document.querySelector('[data-success-message]');
      
      this.init();
    }
  
    init() {
      if (!this.form) return;
  
      this.form.addEventListener('submit', (e) => this.handleSubmit(e));
    }
  
    async handleSubmit(e) {
      e.preventDefault();
      
      const formData = new FormData(this.form);
      const button = this.form.querySelector('.newsletter__button');
      const originalText = button.textContent;
      
      // Show loading state
      button.textContent = 'Subscribing...';
      button.disabled = true;
  
      try {
        const response = await fetch(this.form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json',
          },
        });
  
        if (response.ok) {
          this.showSuccess();
          this.form.reset();
        } else {
          throw new Error('Subscription failed');
        }
      } catch (error) {
        console.error('Newsletter subscription error:', error);
        alert('There was an error subscribing. Please try again.');
      } finally {
        // Reset button
        button.textContent = originalText;
        button.disabled = false;
      }
    }
  
    showSuccess() {
      if (this.successMessage) {
        this.successMessage.classList.add('active');
        setTimeout(() => {
          this.successMessage.classList.remove('active');
        }, 5000);
      }
    }
  }
  
  document.addEventListener('DOMContentLoaded', () => {
    new NewsletterForm();
  });
</script>

{% schema %}
  {
    "name": "Email Newsletter",
    "tag": "section",
    "class": "section",
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Stay in the Loop"
      },
      {
        "type": "richtext",
        "id": "subheading",
        "label": "Subheading",
        "default": "<p>Subscribe to our newsletter for exclusive offers, wellness tips, and product updates.</p>"
      },
      {
        "type": "text",
        "id": "discount_text",
        "label": "Discount offer",
        "default": "Get 10% off your first order",
        "info": "Promotional text displayed above the heading"
      },
      {
        "type": "header",
        "content": "Form settings"
      }, {
        "type": "text",
        "id": "placeholder_text",
        "label": "Input placeholder",
        "default": "Enter your email address"
      }, {
        "type": "text",
        "id": "button_text",
        "label": "Button text",
