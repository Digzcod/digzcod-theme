<div class="relative drop-shadow-lg rounded-md shadow-lg overflow-visible">
  <div class="mx-auto px-4 sm:px-6 overflow-visible">
    <div class="flex justify-center items-center py-6 md:justify-start md:space-x-10 relative overflow-visible">
      <!-- STORE NAME / STORE LOGO -->
      <div class="flex justify-start lg:flex-1 truncate">
        <h1 class="text-xl font-bold truncate">SM STORE</h1>
      </div>

      <!-- NAVIGATION MENU -->
      <nav class="flex items-center gap-x-2 static overflow-visible" role="navigation" aria-label="Main navigation">
        {% for link in linklists['main-menu'].links %}
          {% if link.links != blank %}
            <!-- Dropdown Menu Item -->
            <div class="dropdown-container" data-dropdown-container>
              <button 
                class="dropdown-toggle {% if link.active %} text-blue-500{% endif %}" 
                data-dropdown-toggle="dropdown-{{ forloop.index }}"
                id="dropdown-toggle-{{ forloop.index }}"
                type="button"
                aria-expanded="false"
                aria-haspopup="true"
              >
                <span>{{ link.title }}</span>
                <svg class="dropdown-arrow" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                </svg>
              </button>

              <!-- Dropdown Menu -->
              <div 
                class="dropdown-menu dropdown-hidden" 
                data-dropdown="dropdown-{{ forloop.index }}"
                role="menu"
                aria-labelledby="dropdown-toggle-{{ forloop.index }}"
              >
                <div class="dropdown-items">
                  {% for childlink in link.links %}
                    <a 
                      href="{{ childlink.url }}" 
                      class="dropdown-item {% if childlink.active %} font-semibold text-blue-600{% endif %}"
                      role="menuitem"
                      tabindex="-1"
                    >
                      {{ childlink.title }}
                    </a>
                  {% endfor %}
                </div>
              </div>
            </div>

          {% else %}
            <!-- Regular Menu Item -->
            <div class="nav-item">
              <a 
                href="{{ link.url }}" 
                class="dropdown-toggle {% if link.active %} text-blue-500 font-medium{% endif %}"
              >
                {{ link.title }}
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </nav>

      <div class="hidden gap-x-5 md:flex items-center justify-end md:flex-1 space-x-5 cursor-default">
        <a href="{{routes.cart_url}}" class="whitespace-nowrap text-base text-gray-500 hover:text-gray-900 ">
          <div class="flex items-center ">{% render 'icon-shopping-bag' %} Cart</div>
        </a>
        {% if customer %}
          <a href="{{ routes.account_url }}">Account</a>
          <form method="post" action="{{ routes.account_logout_url }}"><button>Log out</button></form>
        {% else %}
          <a href="{{ routes.account_login_url }}">Sign in</a>
          <a href="{{ routes.account_register_url }}">Create account</a>
        {% endif %}
      </div>
    </div>
  </div>
</div>
