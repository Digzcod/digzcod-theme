{% comment %} 
          Featured Categories Section
           
          This section displays 3-4 featured product categories with images
          and optional links in a responsive grid layout. 
{% endcomment %}

{{ 'category-cards.css' | asset_url | stylesheet_tag }}

{% liquid
  assign grid_cols = section.blocks.size
  if grid_cols > 4
    assign grid_cols = 4
  elsif grid_cols < 3
    assign grid_cols = 3
  endif
%}


<section
  class="featured-categories"
  id="FeaturedCategories-{{ section.id }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --category-gap: {{ section.settings.grid_gap }}px;
  ">
  <div class="featured-categories__container">
    {% if section.settings.heading != blank %}
      <header class="featured-categories__header">
        <{{ section.settings.heading_tag }} class="featured-categories__heading">
          {{ section.settings.heading }}
          </{{ section.settings.heading_tag }}>
          {% if section.settings.subheading != blank %}
            <p class="featured-categories__subheading">
              {{ section.settings.subheading }}
            </p>
          {% endif %}
        </header>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="featured-categories__grid" data-grid-cols="{{ grid_cols }}">
          {% for block in section.blocks %}
            <article
              class="category-card"
              id="CategoryCard-{{ block.id }}"
              {{ block.shopify_attributes }}
              style="
              --category-bg: {{ block.settings.card_bg_color }};
              --category-text: {{ block.settings.text_color }};
              --category-overlay: {{ block.settings.overlay_color }};
              --category-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
            ">
              {% liquid
                assign image = block.settings.image
                assign link_url = block.settings.link_url
                assign title = block.settings.title
                assign description = block.settings.description
                assign button_text = block.settings.button_text
              %}

              {% if link_url != blank %}
                <a
                  href="{{ link_url }}"
                  class="category-card__link"
                  aria-label="{{ title | escape }}">
              {% endif %}

              <div class="category-card__image-wrapper">
                {% if image != blank %}
                  {%- render 'image'
                    , 
 image: image
                    , 
 width: 600
                    ,
 height: 600
                    ,
 class: 'category-card__image'
                  -%}
                {% else %}
                  <div class="category-card__placeholder">
                    {{ 'image' | placeholder_svg_tag: 'category-card__placeholder-svg' }}
                  </div>
                {% endif %}

                {% if block.settings.show_overlay %}
                  <div class="category-card__overlay"></div>
                {% endif %}
              </div>

              <div class="category-card__content">
                {% if title != blank %}
                  <h3 class="category-card__title">{{ title }}</h3>
                {% endif %}

                {% if description != blank %}
                  <p class="category-card__description">{{ description }}</p>
                {% endif %}

                {% if button_text != blank and link_url != blank %}
                  <span class="category-card__button">{{ button_text }}</span>
                {% endif %}
              </div>

              {% if link_url != blank %}
                </a>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      {% else %}
        <div class="featured-categories__empty">
          <p>Add category blocks to display your featured categories</p>
        </div>
      {% endif %}
    </div>
  </section>


  {% schema %}
    {
      "name": "Featured Categories",
      "tag": "section",
      "class": "section",
      "disabled_on": {
        "groups": ["header", "footer"]
      },
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Featured Categories"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "Heading tag",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            }, {
              "value": "h2",
              "label": "H2"
            }, {
              "value": "h3",
              "label": "H3"
            }, {
              "value": "h4",
              "label": "H4"
            }
          ],
          "default": "h2"
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Subheading",
          "default": "Discover our most popular product categories"
        },
        {
          "type": "header",
          "content": "Layout"
        }, {
          "type": "range",
          "id": "grid_gap",
          "label": "Grid gap",
          "min": 16,
          "max": 48,
          "step": 4,
          "unit": "px",
          "default": 24
        }, {
          "type": "header",
          "content": "Spacing"
        }, {
          "type": "range",
          "id": "padding_top",
          "label": "Padding top",
          "min": 0,
          "max": 120,
          "step": 4,
          "unit": "px",
          "default": 60
        }, {
          "type": "range",
          "id": "padding_bottom",
          "label": "Padding bottom",
          "min": 0,
          "max": 120,
          "step": 4,
          "unit": "px",
          "default": 60
        }
      ],
      "blocks": [
        {
          "type": "category",
          "name": "Category Card",
          "settings": [
            {
              "type": "image_picker",
              "id": "image",
              "label": "Image"
            },
            {
              "type": "text",
              "id": "title",
              "label": "Title",
              "default": "Category Name"
            },
            {
              "type": "textarea",
              "id": "description",
              "label": "Description",
              "default": "Explore our collection"
            },
            {
              "type": "url",
              "id": "link_url",
              "label": "Link URL"
            }, {
              "type": "text",
              "id": "button_text",
              "label": "Button text",
              "default": "Shop Now"
            }, {
              "type": "header",
              "content": "Colors"
            }, {
              "type": "color",
              "id": "card_bg_color",
              "label": "Card background",
              "default": "#ffffff"
            }, {
              "type": "color",
              "id": "text_color",
              "label": "Text color",
              "default": "#ffffff"
            }, {
              "type": "checkbox",
              "id": "show_overlay",
              "label": "Show overlay",
              "default": true
            }, {
              "type": "color",
              "id": "overlay_color",
              "label": "Overlay color",
              "default": "#000000"
            }, {
              "type": "range",
              "id": "overlay_opacity",
              "label": "Overlay opacity",
              "min": 0,
              "max": 80,
              "step": 5,
              "unit": "%",
              "default": 30
            }
          ]
        }
      ],
      "presets": [
        {
          "name": "Featured Categories",
          "blocks": [
            {
              "type": "category",
              "settings": {
                "title": "Diffusers",
                "description": "Transform your space with our premium diffusers"
              }
            }, {
              "type": "category",
              "settings": {
                "title": "Essential Oils",
                "description": "Pure, therapeutic-grade essential oils"
              }
            }, {
              "type": "category",
              "settings": {
                "title": "Gift Sets",
                "description": "Curated collections for every occasion"
              }
            }, {
              "type": "category",
              "settings": {
                "title": "Accessories",
                "description": "Everything you need for aromatherapy"
              }
            }
          ]
        }
      ]
    }
  {% endschema %}