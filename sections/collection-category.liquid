{% comment %}
  Featured Categories Section
  
  This section displays 3-4 featured product categories with images
  and optional links in a responsive grid layout.
{% endcomment %}

{% liquid
  assign grid_cols = section.blocks.size
  if grid_cols > 4
    assign grid_cols = 4
  elsif grid_cols < 3
    assign grid_cols = 3
  endif
%}

<section 
  class="featured-categories" 
  id="FeaturedCategories-{{ section.id }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --category-gap: {{ section.settings.grid_gap }}px;
  "
>
  <div class="featured-categories__container">
    {% if section.settings.heading != blank %}
      <header class="featured-categories__header">
        <{{ section.settings.heading_tag }} class="featured-categories__heading">
          {{ section.settings.heading }}
        </{{ section.settings.heading_tag }}>
        {% if section.settings.subheading != blank %}
          <p class="featured-categories__subheading">
            {{ section.settings.subheading }}
          </p>
        {% endif %}
      </header>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="featured-categories__grid" data-grid-cols="{{ grid_cols }}">
        {% for block in section.blocks %}
          <article 
            class="category-card" 
            id="CategoryCard-{{ block.id }}"
            {{ block.shopify_attributes }}
            style="
              --category-bg: {{ block.settings.card_bg_color }};
              --category-text: {{ block.settings.text_color }};
              --category-overlay: {{ block.settings.overlay_color }};
              --category-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
            "
          >
            {% liquid
              assign image = block.settings.image
              assign link_url = block.settings.link_url
              assign title = block.settings.title
              assign description = block.settings.description
              assign button_text = block.settings.button_text
            %}

            {% if link_url != blank %}
              <a href="{{ link_url }}" class="category-card__link" aria-label="{{ title | escape }}">
            {% endif %}

            <div class="category-card__image-wrapper">
              {% if image != blank %}
                {%- render 'image', 
                    image: image, 
                    width: 600,
                    height: 600,
                    class: 'category-card__image'
                -%}
              {% else %}
                <div class="category-card__placeholder">
                  {{ 'image' | placeholder_svg_tag: 'category-card__placeholder-svg' }}
                </div>
              {% endif %}
              
              {% if block.settings.show_overlay %}
                <div class="category-card__overlay"></div>
              {% endif %}
            </div>

            <div class="category-card__content">
              {% if title != blank %}
                <h3 class="category-card__title">{{ title }}</h3>
              {% endif %}
              
              {% if description != blank %}
                <p class="category-card__description">{{ description }}</p>
              {% endif %}
              
              {% if button_text != blank and link_url != blank %}
                <span class="category-card__button">{{ button_text }}</span>
              {% endif %}
            </div>

            {% if link_url != blank %}
              </a>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="featured-categories__empty">
        <p>Add category blocks to display your featured categories</p>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .featured-categories {
    padding: var(--section-padding-top, 60px) 0 var(--section-padding-bottom, 60px);
    background: var(--color-background);
  }

  .featured-categories__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .featured-categories__header {
    text-align: center;
    margin-bottom: 48px;
  }

  .featured-categories__heading {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    color: var(--color-foreground);
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .featured-categories__subheading {
    font-size: 1.125rem;
    color: var(--color-foreground-75);
    margin: 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.5;
  }

  .featured-categories__grid {
    display: grid;
    gap: var(--category-gap, 24px);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .featured-categories__grid[data-grid-cols="3"] {
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }

  .featured-categories__grid[data-grid-cols="4"] {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .category-card {
    position: relative;
    background: var(--category-bg, var(--color-background));
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
  }

  .category-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  }

  .category-card__link {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .category-card__image-wrapper {
    position: relative;
    flex: 1;
    overflow: hidden;
  }

  .category-card__image,
  .category-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .category-card:hover .category-card__image {
    transform: scale(1.05);
  }

  .category-card__placeholder {
    background: var(--color-background-2);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .category-card__placeholder-svg {
    width: 64px;
    height: 64px;
    opacity: 0.3;
  }

  .category-card__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--category-overlay, rgba(0, 0, 0, 0.3));
    opacity: var(--category-overlay-opacity, 0.3);
    transition: opacity 0.3s ease;
  }

  .category-card:hover .category-card__overlay {
    opacity: calc(var(--category-overlay-opacity, 0.3) * 0.7);
  }

  .category-card__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    color: var(--category-text, white);
    text-align: center;
    transform: translateY(8px);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .category-card:hover .category-card__content {
    transform: translateY(0);
  }

  .category-card__title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .category-card__description {
    font-size: 0.875rem;
    margin: 0 0 12px 0;
    opacity: 0.9;
    line-height: 1.4;
  }

  .category-card__button {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 8px 16px;
    background: var(--color-button);
    color: var(--color-button-text);
    border-radius: 6px;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .category-card:hover .category-card__button {
    background: var(--color-button-hover);
    transform: translateY(-2px);
  }

  .featured-categories__empty {
    text-align: center;
    padding: 60px 20px;
    color: var(--color-foreground-75);
  }

  /* Responsive Design */
  @media screen and (max-width: 767px) {
    .featured-categories {
      padding: var(--section-padding-top, 40px) 0 var(--section-padding-bottom, 40px);
    }

    .featured-categories__container {
      padding: 0 16px;
    }

    .featured-categories__header {
      margin-bottom: 32px;
    }

    .featured-categories__grid {
      gap: var(--category-gap, 16px);
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    }

    .category-card__content {
      padding: 20px 16px;
    }

    .category-card__title {
      font-size: 1.125rem;
    }
  }

  @media screen and (min-width: 768px) and (max-width: 1199px) {
    .featured-categories__grid[data-grid-cols="4"] {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 1200px) {
    .featured-categories__grid[data-grid-cols="3"] {
      grid-template-columns: repeat(3, 1fr);
    }

    .featured-categories__grid[data-grid-cols="4"] {
      grid-template-columns: repeat(4, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured Categories",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Categories"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover our most popular product categories"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category Name"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Explore our collection"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop Now"
        },
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "id": "card_bg_color",
          "label": "Card background",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        },
        {
          "type": "checkbox",
          "id": "show_overlay",
          "label": "Show overlay",
          "default": true
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Overlay color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "default": 30
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Diffusers",
            "description": "Transform your space with our premium diffusers"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Essential Oils",
            "description": "Pure, therapeutic-grade essential oils"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Gift Sets",
            "description": "Curated collections for every occasion"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Accessories",
            "description": "Everything you need for aromatherapy"
          }
        }
      ]
    }
  ]
}
{% endschema %}
