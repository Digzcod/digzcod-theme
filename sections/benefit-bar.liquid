{% comment %} 
                                        Section: Benefit / Trust Bar (benefit-bar) 
                                        - Displays small badges like Free Shipping, 30-Day Returns, 24/7 Support inside a rounded pill. 
                                        - Files: benefit-bar.css, benefit-bar.js 
{% endcomment %}

{{ 'benefit-bar.css' | asset_url | stylesheet_tag }}
<script src="{{ 'benefit-bar.js' | asset_url }}" defer></script>

<section
  class="benefit-bar"
  data-section-id="{{ section.id }}"
  style="
    --bb-text: {{ section.settings.text_color }};
    --bb-bg: {% assign bg_opacity_decimal = section.settings.bg_opacity | divided_by: 100.0 %}{% if section.settings.bg_opacity == 100 %}{{ section.settings.bg_color }}{% else %}{{ section.settings.bg_color | color_modify: 'alpha', bg_opacity_decimal }}{% endif %};
    --bb-border: {% assign border_opacity_decimal = section.settings.border_opacity | divided_by: 100.0 %}{% if section.settings.border_opacity == 100 %}{{ section.settings.border_color }}{% else %}{{ section.settings.border_color | color_modify: 'alpha', border_opacity_decimal }}{% endif %};
    --bb-accent: {{ section.settings.accent_color }};
    --bb-radius: {{ section.settings.radius }}px;
    --bb-gap: {{ section.settings.gap }}px;
    --bb-pad-y: {{ section.settings.pad_y }}px;
    --bb-pad-x: {{ section.settings.pad_x }}px;
    --bb-maxw: {{ section.settings.max_width }}px;
    --bb-shadow: {{ section.settings.shadow }};
    --bb-sep: {% assign sep_opacity_decimal = section.settings.separator_opacity | divided_by: 100.0 %}{% if section.settings.separator_opacity == 100 %}{{ section.settings.separator_color }}{% else %}{{ section.settings.separator_color | color_modify: 'alpha', sep_opacity_decimal }}{% endif %};
    --bb-blur: {{ section.settings.blur_strength }}px;
    --bb-margin-top: {{ section.settings.margin_top }}px;
    --bb-margin-bottom: {{ section.settings.margin_bottom }}px;
    --bb-position-top: {{ section.settings.position_top }}px;
    --bb-z-index: {{ section.settings.z_index }};
  ">
  <div class="benefit-bar__wrap benefit-bar__wrap--{{ section.settings.align }}">
    <div class="benefit-bar__pill{% if section.settings.scroll_on_mobile %} benefit-bar__pill--scroll{% endif %}">
      {% for block in section.blocks %}
        {% if block.type == 'item' %}
          {% if block.settings.link != blank %}
            <a
              href="{{ block.settings.link }}"
              class="bb-item"
              {{ block.shopify_attributes }}>
              {% if block.settings.icon != 'none' %}
                <span
                  class="bb-item__icon"
                  data-icon="{{ block.settings.icon }}"
                  aria-hidden="true"></span>
              {% endif %}
              <span class="bb-item__text">{{ block.settings.text | escape }}</span>
            </a>
          {% else %}
            <div class="bb-item" {{ block.shopify_attributes }}>
              {% if block.settings.icon != 'none' %}
                <span
                  class="bb-item__icon"
                  data-icon="{{ block.settings.icon }}"
                  aria-hidden="true"></span>
              {% endif %}
              <span class="bb-item__text">{{ block.settings.text | escape }}</span>
            </div>
          {% endif %}
          {% if forloop.index < section.blocks.size and section.settings.show_separators %}
            <span class="bb-sep" aria-hidden="true"></span>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Benefit / Trust Bar",
    "tag": "section",
    "class": "section--benefit-bar",
    "settings": [
      {
        "type": "select",
        "id": "align",
        "label": "Alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          }, {
            "value": "center",
            "label": "Center"
          }, {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "range",
        "id": "max_width",
        "label": "Max width (px)",
        "min": 600,
        "max": 1600,
        "step": 20,
        "default": 1100
      },
      {
        "type": "header",
        "content": "Position & Layout"
      },
      {
        "type": "range",
        "id": "position_top",
        "label": "Distance from top (px)",
        "min": 0,
        "max": 200,
        "step": 4,
        "default": 20
      }, {
        "type": "range",
        "id": "z_index",
        "label": "Layer priority (z-index)",
        "min": 1,
        "max": 100,
        "step": 1,
        "default": 100
      }, {
        "type": "range",
        "id": "margin_top",
        "label": "Internal top padding (px)",
        "min": 0,
        "max": 100,
        "step": 4,
        "default": 8
      }, {
        "type": "range",
        "id": "margin_bottom",
        "label": "Internal bottom padding (px)",
        "min": 0,
        "max": 100,
        "step": 4,
        "default": 8
      }, {
        "type": "checkbox",
        "id": "scroll_on_mobile",
        "label": "Allow horizontal scroll on mobile",
        "default": true
      }, {
        "type": "checkbox",
        "id": "show_separators",
        "label": "Show separators between items",
        "default": true
      }, {
        "type": "header",
        "content": "Colors & style"
      }, {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "default": "#2B2B2B"
      }, {
        "type": "color",
        "id": "accent_color",
        "label": "Icon accent color",
        "default": "#0E7A3D"
      }, {
        "type": "color",
        "id": "bg_color",
        "label": "Background color",
        "default": "#FFFFFF"
      }, {
        "type": "range",
        "id": "bg_opacity",
        "label": "Background opacity (%)",
        "min": 0,
        "max": 100,
        "step": 5,
        "default": 100
      }, {
        "type": "range",
        "id": "blur_strength",
        "label": "Backdrop blur (px)",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 8
      }, {
        "type": "color",
        "id": "border_color",
        "label": "Border color",
        "default": "#000000"
      }, {
        "type": "range",
        "id": "border_opacity",
        "label": "Border opacity (%)",
        "min": 0,
        "max": 100,
        "step": 5,
        "default": 10
      }, {
        "type": "color",
        "id": "separator_color",
        "label": "Separator color",
        "default": "#000000"
      }, {
        "type": "range",
        "id": "separator_opacity",
        "label": "Separator opacity (%)",
        "min": 0,
        "max": 100,
        "step": 5,
        "default": 10
      }, {
        "type": "range",
        "id": "radius",
        "label": "Corner radius (px)",
        "min": 8,
        "max": 100,
        "step": 1,
        "default": 15
      }, {
        "type": "range",
        "id": "pad_x",
        "label": "Horizontal padding (px)",
        "min": 8,
        "max": 28,
        "step": 1,
        "default": 18
      }, {
        "type": "range",
        "id": "pad_y",
        "label": "Vertical padding (px)",
        "min": 6,
        "max": 20,
        "step": 1,
        "default": 10
      }, {
        "type": "range",
        "id": "gap",
        "label": "Gap between items (px)",
        "min": 6,
        "max": 28,
        "step": 1,
        "default": 18
      }, {
        "type": "select",
        "id": "shadow",
        "label": "Shadow",
        "default": "0 6px 18px rgba(0,0,0,.12)",
        "options": [
          {
            "value": "none",
            "label": "None"
          }, {
            "value": "0 2px 8px rgba(0,0,0,.08)",
            "label": "Soft"
          }, {
            "value": "0 6px 18px rgba(0,0,0,.12)",
            "label": "Medium"
          }, {
            "value": "0 10px 28px rgba(0,0,0,.18)",
            "label": "Strong"
          }
        ]
      }
    ],
    "blocks": [
      {
        "type": "item",
        "name": "Benefit item",
        "limit": 8,
        "settings": [
          {
            "type": "select",
            "id": "icon",
            "label": "Icon",
            "default": "shipping",
            "options": [
              {
                "value": "shipping",
                "label": "Shipping"
              },
              {
                "value": "returns",
                "label": "Returns"
              },
              {
                "value": "support",
                "label": "Support"
              },
              {
                "value": "secure",
                "label": "Secure"
              }, {
                "value": "leaf",
                "label": "Natural"
              }, {
                "value": "star",
                "label": "Star"
              }, {
                "value": "time",
                "label": "Time"
              }, {
                "value": "none",
                "label": "None"
              }
            ]
          }, {
            "type": "text",
            "id": "text",
            "label": "Text",
            "default": "Free Shipping"
          }, {
            "type": "url",
            "id": "link",
            "label": "Optional link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Benefit / Trust Bar",
        "blocks": [
          {
            "type": "item",
            "settings": {
              "icon": "shipping",
              "text": "Free Shipping"
            }
          }, {
            "type": "item",
            "settings": {
              "icon": "returns",
              "text": "30-Day Returns"
            }
          }, {
            "type": "item",
            "settings": {
              "icon": "support",
              "text": "24/7 Support"
            }
          }
        ]
      }
    ]
  }
{% endschema %}