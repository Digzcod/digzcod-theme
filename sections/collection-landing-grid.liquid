{% comment %} 
                  Collection Landing Grid - Aromatherapy Store
                  A comprehensive landing section with advanced filter sidebar and feature grid for aromatherapy products
                  Features: Multi-level filters, price ranges, category highlights, enterprise-level customization 
{% endcomment %}

{%- liquid
  assign section_id = 'CollectionLandingGrid-' | append: section.id
  assign bg_class = 'bg-default'
  if section.settings.background_color == 'subtle-cream'
    assign bg_class = 'bg-cream'
  elsif section.settings.background_color == 'soft-white'
    assign bg_class = 'bg-soft-white'
  endif

  assign typography_class = 'typography-serif'
  if section.settings.typography == 'sans'
    assign typography_class = 'typography-sans'
  endif
-%}

{% style %}
  #{{ section_id }}
{
  --section-padding-top: {{ section.settings.padding_top | default: 48 | append: 'px' }};
  --section-padding-bottom: {{ section.settings.padding_bottom | default: 48 | append: 'px' }};
  --filter-width: {{ section.settings.filter_width | default: 280 | append: 'px' }};
  --content-gap: {{ section.settings.content_gap | default: 48 | append: 'px' }};
}
{% endstyle %}

<div class="collection-landing-grid {{ bg_class }} {{ typography_class }}" id="{{ section_id }}">
  <div class="collection-landing-grid__container">

    {% comment %} Section Header {% endcomment %}
    {% if section.settings.show_header %}
      <div class="collection-landing-grid__header">
        {% if section.settings.title != blank %}
          <h2 class="collection-landing-grid__title">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="collection-landing-grid__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="collection-landing-grid__content">

      {% comment %} Desktop Filter Sidebar {% endcomment %}
      <div class="filter-sidebar">
        <h3 class="filter-sidebar__title">
          {{ section.settings.filter_title | default: 'Filter By' }}
        </h3>

        {% comment %} Oil Type Filters {% endcomment %}
        <div class="filter-group is-expanded">
          <div class="filter-group__header" onclick="toggleFilterGroup(this)">
            <h4 class="filter-group__title">{{ section.settings.oil_type_title | default: 'Oil Type' }}</h4>
            <svg
              class="filter-group__chevron"
              viewBox="0 0 16 16"
              fill="currentColor">
              <path d="M4.646 6.646a.5.5 0 0 1 .708 0L8 9.293l2.646-2.647a.5.5 0 0 1 .708.708l-3 3a.5.5 0 0 1-.708 0l-3-3a.5.5 0 0 1 0-.708z" />
            </svg>
          </div>
          <div class="filter-group__content">
            {% assign oil_types = 'Lavender,Citrus,Floral,Herbal' | split: ',' %}
            {% assign oil_urls = section.settings.oil_filter_urls | split: ',' %}
            {% assign oil_counts = section.settings.oil_filter_counts | split: ',' %}

            {% for oil in oil_types %}
              {% assign index = forloop.index0 %}
              {% assign url = oil_urls[index] | default: '/collections/essential-oils?filter.p.tag=' | append: oil %}
              {% assign count = oil_counts[index] | default: '0' %}

              <a href="{{ url }}" class="filter-item">
                <span>{{ oil | strip }}</span>
                {% if count != '0' and count != blank %}
                  <span class="filter-item__count">{{ count }}</span>
                {% endif %}
              </a>
            {% endfor %}
          </div>
        </div>

        {% comment %} Diffuser Type Filters {% endcomment %}
        <div class="filter-group is-expanded">
          <div class="filter-group__header" onclick="toggleFilterGroup(this)">
            <h4 class="filter-group__title">{{ section.settings.diffuser_type_title | default: 'Diffuser Type' }}</h4>
            <svg
              class="filter-group__chevron"
              viewBox="0 0 16 16"
              fill="currentColor">
              <path d="M4.646 6.646a.5.5 0 0 1 .708 0L8 9.293l2.646-2.647a.5.5 0 0 1 .708.708l-3 3a.5.5 0 0 1-.708 0l-3-3a.5.5 0 0 1 0-.708z" />
            </svg>
          </div>
          <div class="filter-group__content">
            {% assign diffuser_types = 'Ceramic,Glass,Portable' | split: ',' %}
            {% assign diffuser_urls = section.settings.diffuser_filter_urls | split: ',' %}
            {% assign diffuser_counts = section.settings.diffuser_filter_counts | split: ',' %}

            {% for diffuser in diffuser_types %}
              {% assign index = forloop.index0 %}
              {% assign url = diffuser_urls[index] | default: '/collections/diffusers?filter.p.tag=' | append: diffuser %}
              {% assign count = diffuser_counts[index] | default: '0' %}

              <a href="{{ url }}" class="filter-item">
                <span>{{ diffuser | strip }}</span>
                {% if count != '0' and count != blank %}
                  <span class="filter-item__count">{{ count }}</span>
                {% endif %}
              </a>
            {% endfor %}
          </div>
        </div>

        {% comment %} Custom Filter Groups {% endcomment %}
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'filter_group' %}
              <div class="filter-group is-expanded" {{ block.shopify_attributes }}>
                <div class="filter-group__header" onclick="toggleFilterGroup(this)">
                  <h4 class="filter-group__title">{{ block.settings.title }}</h4>
                  <svg
                    class="filter-group__chevron"
                    viewBox="0 0 16 16"
                    fill="currentColor">
                    <path d="M4.646 6.646a.5.5 0 0 1 .708 0L8 9.293l2.646-2.647a.5.5 0 0 1 .708.708l-3 3a.5.5 0 0 1-.708 0l-3-3a.5.5 0 0 1 0-.708z" />
                  </svg>
                </div>
                <div class="filter-group__content">
                  {% assign filter_items = block.settings.filter_items | split: ',' %}
                  {% assign filter_urls = block.settings.filter_urls | split: ',' %}
                  {% assign filter_counts = block.settings.filter_counts | split: ',' %}

                  {% for item in filter_items %}
                    {% assign index = forloop.index0 %}
                    {% assign url = filter_urls[index] | default: '#' %}
                    {% assign count = filter_counts[index] | default: '0' %}

                    <a href="{{ url }}" class="filter-item">
                      <span>{{ item | strip }}</span>
                      {% if count != '0' and count != blank %}
                        <span class="filter-item__count">{{ count }}</span>
                      {% endif %}
                    </a>
                  {% endfor %}
                </div>
              </div>
          {% endcase %}
        {% endfor %}

        {% comment %} Price Range Filter {% endcomment %}
        {% if section.settings.show_price_filter %}
          <div class="filter-price-range">
            <h4 class="filter-price-range__title">{{ section.settings.price_range_title | default: 'Price Range' }}</h4>
            <div class="filter-price-range__inputs">
              <input
                type="number"
                class="filter-price-range__input"
                placeholder="{{ section.settings.min_price_placeholder | default: 'Min' }}"
                min="0"
                step="0.01">
              <span class="filter-price-range__separator">—</span>
              <input
                type="number"
                class="filter-price-range__input"
                placeholder="{{ section.settings.max_price_placeholder | default: 'Max' }}"
                min="0"
                step="0.01">
            </div>
          </div>
        {% endif %}

        {% comment %} Clear Filters {% endcomment %}
        {% if section.settings.show_clear_filters %}
          <div class="filter-clear">
            <button
              type="button"
              class="filter-clear__button"
              onclick="clearAllFilters()">
              {{ section.settings.clear_filters_text | default: 'Clear All Filters' }}
            </button>
          </div>
        {% endif %}
      </div>

      {% comment %} Mobile Filter Accordion {% endcomment %}
      {% if section.settings.mobile_accordion %}
        <div class="mobile-filter-accordion">
          <button
            class="mobile-filter-toggle"
            onclick="toggleMobileFilters(this)"
            aria-expanded="false">
            <span>{{ section.settings.filter_title | default: 'Filter By' }}</span>
            <svg
              class="filter-group__chevron"
              viewBox="0 0 16 16"
              fill="currentColor">
              <path d="M4.646 6.646a.5.5 0 0 1 .708 0L8 9.293l2.646-2.647a.5.5 0 0 1 .708.708l-3 3a.5.5 0 0 1-.708 0l-3-3a.5.5 0 0 1 0-.708z" />
            </svg>
          </button>
          <div class="mobile-filter-content">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'filter_group' %}
                  <div class="filter-group is-expanded">
                    <div class="filter-group__header">
                      <h4 class="filter-group__title">{{ block.settings.title }}</h4>
                    </div>
                    <div class="filter-group__content">
                      {% assign filter_items = block.settings.filter_items | split: ',' %}
                      {% assign filter_urls = block.settings.filter_urls | split: ',' %}
                      {% assign filter_counts = block.settings.filter_counts | split: ',' %}

                      {% for item in filter_items %}
                        {% assign index = forloop.index0 %}
                        {% assign url = filter_urls[index] | default: '#' %}
                        {% assign count = filter_counts[index] | default: '0' %}

                        <a href="{{ url }}" class="filter-item">
                          <span>{{ item | strip }}</span>
                          {% if count != '0' and count != blank %}
                            <span class="filter-item__count">{{ count }}</span>
                          {% endif %}
                        </a>
                      {% endfor %}
                    </div>
                  </div>
              {% endcase %}
            {% endfor %}

            {% comment %} Price Range Filter {% endcomment %}
            {% if section.settings.show_price_filter %}
              <div class="filter-price-range">
                <h4 class="filter-price-range__title">{{ section.settings.price_range_title | default: 'Price Range' }}</h4>
                <div class="filter-price-range__inputs">
                  <input
                    type="number"
                    class="filter-price-range__input"
                    placeholder="{{ section.settings.min_price_placeholder | default: 'Min' }}"
                    min="0"
                    step="0.01">
                  <span class="filter-price-range__separator">—</span>
                  <input
                    type="number"
                    class="filter-price-range__input"
                    placeholder="{{ section.settings.max_price_placeholder | default: 'Max' }}"
                    min="0"
                    step="0.01">
                </div>
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% comment %} Collection Highlights Grid {% endcomment %}
      <div class="collection-highlights">
        <h3 class="collection-highlights__title">
          {{ section.settings.highlights_title | default: 'Collection Highlights' }}
        </h3>

        <div class="collection-highlights__grid">
          {% comment %} Dynamic Collection Cards {% endcomment %}
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'collection_card' %}
                {%- comment -%} Prefer merchant-selected collection data as defaults; allow manual overrides in the block settings {%- endcomment -%}
                {% assign selected_collection = block.settings.collection %}
                {% assign card_image = block.settings.image %}
                {% assign card_title = block.settings.title %}
                {% assign card_description = block.settings.description %}
                {% assign card_url = block.settings.url %}
                {% assign card_category = block.settings.category %}

                {% if selected_collection %}
                  {% if selected_collection.image %}
                    {% assign card_image = selected_collection.image %}
                  {% endif %}
                  {% if card_title == blank and selected_collection.title %}
                    {% assign card_title = selected_collection.title %}
                  {% endif %}
                  {% if card_description == blank and selected_collection.description != blank %}
                    {% assign card_description = selected_collection.description | strip_html | truncate: 160 %}
                  {% endif %}
                  {% if card_url == blank and selected_collection.handle %}
                    {% assign card_url = routes.collections_url | append: '/' | append: selected_collection.handle %}
                  {% endif %}
                  {% if card_category == blank and selected_collection.title %}
                    {% assign card_category = selected_collection.title %}
                  {% endif %}
                {% endif %}

                <div class="collection-card" {{ block.shopify_attributes }}>
                  <div class="collection-card__image-wrapper">
                    {% if card_image %}
                      <img
                        src="{{ card_image | image_url: width: 600 }}"
                        width="600"
                        height="480"
                        class="collection-card__image"
                        loading="lazy"
                        alt="{{ card_title | default: 'Collection' }}" />
                    {% else %}
                      <div class="collection-card__placeholder">
                        <svg
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          class="collection-card__placeholder-icon">
                          <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" />
                        </svg>
                      </div>
                    {% endif %}

                    {% if block.settings.badge %}
                      <span class="collection-card__badge">{{ block.settings.badge }}</span>
                    {% endif %}

                    {% if block.settings.overlay_opacity > 0 %}
                      <div class="collection-card__overlay" style="opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"></div>
                    {% endif %}
                  </div>

                  <div class="collection-card__content">
                    {% if card_category %}
                      <div class="collection-card__category">{{ card_category }}</div>
                    {% endif %}

                    {% if card_title %}
                      <h4 class="collection-card__title">{{ card_title }}</h4>
                    {% endif %}

                    {% if card_description %}
                      <p class="collection-card__description">{{ card_description }}</p>
                    {% endif %}

                    {% if block.settings.price_text %}
                      <div class="collection-card__price">{{ block.settings.price_text }}</div>
                    {% endif %}

                    {% if card_url %}
                      <a href="{{ card_url }}" class="collection-card__button">
                        {{ block.settings.button_text | default: 'See More' }}
                        {% if block.settings.show_arrow %}
                          <svg
                            viewBox="0 0 16 16"
                            fill="currentColor"
                            class="collection-card__arrow">
                            <path d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z" />
                          </svg>
                        {% endif %}
                      </a>
                    {% endif %}
                  </div>
                </div>
            {% endcase %}
          {% endfor %}

          {% comment %} Default Cards if no blocks present {% endcomment %}
          {% if section.blocks.size == 0 %}
            <div class="collection-card">
              <div class="collection-card__image-wrapper">
                <div class="collection-card__placeholder">
                  <svg
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="collection-card__placeholder-icon">
                    <path d="M12 2L2 7v10c0 5.55 3.84 9.739 8.608 11.52c.24.09.504.09.744 0C16.16 26.739 20 22.55 20 17V7L12 2z" />
                  </svg>
                </div>
              </div>
              <div class="collection-card__content">
                <div class="collection-card__category">Essential Oils</div>
                <h4 class="collection-card__title">Pure Essential Oils</h4>
                <p class="collection-card__description">Discover our premium collection of therapeutic-grade essential oils for wellness and aromatherapy.</p>
                <a href="{{ routes.collections_url }}/essential-oils" class="collection-card__button">
                  Shop Essential Oils
                  <svg
                    viewBox="0 0 16 16"
                    fill="currentColor"
                    class="collection-card__arrow">
                    <path d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z" />
                  </svg>
                </a>
              </div>
            </div>

            <div class="collection-card">
              <div class="collection-card__image-wrapper">
                <div class="collection-card__placeholder">
                  <svg
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="collection-card__placeholder-icon">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" />
                  </svg>
                </div>
              </div>
              <div class="collection-card__content">
                <div class="collection-card__category">Diffusers</div>
                <h4 class="collection-card__title">Premium Diffusers</h4>
                <p class="collection-card__description">Elegant and functional diffusers to transform your space with beautiful aromas and ambiance.</p>
                <a href="{{ routes.collections_url }}/diffusers" class="collection-card__button">
                  Shop Diffusers
                  <svg
                    viewBox="0 0 16 16"
                    fill="currentColor"
                    class="collection-card__arrow">
                    <path d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z" />
                  </svg>
                </a>
              </div>
            </div>

            <div class="collection-card">
              <div class="collection-card__image-wrapper">
                <div class="collection-card__placeholder">
                  <svg
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="collection-card__placeholder-icon">
                    <path d="M20 6h-2.18c.11-.31.18-.65.18-1a2.996 2.996 0 0 0-5.5-1.65l-.5.67-.5-.68C10.96 2.54 10 2 10 2s-1.96.54-2.5 1.34l-.5.68-.5-.67C5.64 2.57 4.82 2.25 4 2.25s-1.64.32-2 1.09C1.36 4.02 2 5.36 2 5.36l2.18.64H4c-1.1 0-2 .9-2 2v9c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z" />
                  </svg>
                </div>
              </div>
              <div class="collection-card__content">
                <div class="collection-card__category">Gift Sets</div>
                <h4 class="collection-card__title">Curated Gift Sets</h4>
                <p class="collection-card__description">Thoughtfully curated gift sets perfect for introducing loved ones to the world of aromatherapy.</p>
                <a href="{{ routes.collections_url }}/gift-sets" class="collection-card__button">
                  Shop Gift Sets
                  <svg
                    viewBox="0 0 16 16"
                    fill="currentColor"
                    class="collection-card__arrow">
                    <path d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z" />
                  </svg>
                </a>
              </div>
            </div>
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</div>

{% stylesheet %}
  .collection-landing-grid {
    padding-top: var(--section-padding-top, 3rem);
    padding-bottom: var(--section-padding-bottom, 3rem);
    background-color: var(--bg-color);
    background-image: var(--bg-pattern, none);
    background-size: var(--bg-size, auto);
    background-position: var(--bg-position, center);
    background-repeat: var(--bg-repeat, no-repeat);
    position: relative;
    overflow: hidden;
  }

  .collection-landing-grid::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--bg-overlay, transparent);
    pointer-events: none;
    z-index: 1;
  }

  .collection-landing-grid > * {
    position: relative;
    z-index: 2;
  }

  .collection-landing-grid.bg-default {
    --bg-color: rgb(var(--color-background));
    --bg-overlay: transparent;
  }

  .collection-landing-grid.bg-cream {
    --bg-color: #fefdfb;
    --bg-pattern: radial-gradient(circle at 20% 50%, rgba(251, 240, 220, 0.3) 0%, transparent 50%), radial-gradient(circle at 80% 20%, rgba(245, 237, 225, 0.3) 0%, transparent 50%);
    --bg-overlay: linear-gradient(135deg, rgba(251, 240, 220, 0.1) 0%, rgba(245, 237, 225, 0.05) 100%);
  }

  .collection-landing-grid.bg-soft-white {
    --bg-color: #fafafa;
    --bg-pattern: radial-gradient(circle at 30% 40%, rgba(255, 255, 255, 0.8) 0%, transparent 50%), radial-gradient(circle at 70% 70%, rgba(248, 250, 252, 0.6) 0%, transparent 50%);
    --bg-overlay: linear-gradient(45deg, rgba(255, 255, 255, 0.1) 0%, rgba(248, 250, 252, 0.05) 100%);
  }

  .collection-landing-grid__container {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 var(--page-margin, 1rem);
  }

  .collection-landing-grid__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .collection-landing-grid__title {
    font-size: var(--font-size-3xl, 2.25rem);
    font-weight: var(--font-weight-bold, 700);
    color: rgb(var(--color-foreground));
    margin: 0 0 1rem;
    line-height: 1.2;
  }

  .collection-landing-grid__subtitle {
    font-size: var(--font-size-lg, 1.125rem);
    color: rgba(var(--color-foreground), 0.7);
    margin: 0 auto;
    max-width: 600px;
  }

  .collection-landing-grid__content {
    display: grid;
    grid-template-columns: var(--filter-width, 280px) 1fr;
    gap: var(--content-gap, 3rem);
    align-items: start;
  }

  /* Enhanced Filter Sidebar */
  .filter-sidebar {
    background: rgb(var(--color-card-background, var(--color-background)));
    border-radius: var(--border-radius-card, 8px);
    padding: 2rem;
    border: 1px solid rgba(var(--color-border), 0.1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    position: sticky;
    top: 2rem;
  }

  .filter-sidebar__title {
    font-size: var(--font-size-xl, 1.25rem);
    font-weight: var(--font-weight-semibold, 600);
    color: rgb(var(--color-foreground));
    margin: 0 0 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(var(--color-border), 0.1);
  }

  .filter-group {
    margin-bottom: 2rem;
  }

  .filter-group:last-child {
    margin-bottom: 1rem;
  }

  .filter-group__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(var(--color-border), 0.1);
    margin-bottom: 1rem;
    transition: all 0.2s ease;
  }

  .filter-group__header:hover {
    color: rgb(var(--color-accent-1));
  }

  .filter-group__title {
    font-size: var(--font-size-base, 1rem);
    font-weight: var(--font-weight-medium, 500);
    color: rgb(var(--color-foreground));
    margin: 0;
    transition: color 0.2s ease;
  }

  .filter-group__chevron {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
    color: rgba(var(--color-foreground), 0.6);
  }

  .filter-group.is-expanded .filter-group__chevron {
    transform: rotate(180deg);
  }

  .filter-group__content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .filter-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    color: rgba(var(--color-foreground), 0.8);
    font-size: var(--font-size-sm, 0.875rem);
    padding: 0.5rem 0.75rem;
    transition: all 0.2s ease;
    border-radius: 6px;
    position: relative;
  }

  .filter-item:hover {
    color: rgb(var(--color-accent-1));
    background-color: rgba(var(--color-accent-1), 0.05);
    text-decoration: none;
  }

  .filter-item:focus {
    outline: 2px solid rgb(var(--color-accent-1));
    outline-offset: 2px;
  }

  .filter-item__count {
    background: rgba(var(--color-foreground), 0.1);
    color: rgba(var(--color-foreground), 0.7);
    padding: 0.125rem 0.5rem;
    border-radius: 12px;
    font-size: var(--font-size-xs, 0.75rem);
    font-weight: var(--font-weight-medium, 500);
    min-width: 20px;
    text-align: center;
    transition: all 0.2s ease;
  }

  .filter-item:hover .filter-item__count {
