<script>
  function toggleFilterGroup(header) {
    const group = header.closest('.filter-group');
    const content = group.querySelector('.filter-group__content');
    const chevron = header.querySelector('.filter-group__chevron');
    const isExpanded = group.classList.contains('is-expanded');
    
    if (isExpanded) {
      group.classList.remove('is-expanded');
      content.style.maxHeight = '0';
      content.style.opacity = '0';
    } else {
      group.classList.add('is-expanded');
      content.style.maxHeight = content.scrollHeight + 'px';
      content.style.opacity = '1';
    }
  }
  
  function toggleMobileFilters(button) {
    const accordion = button.closest('.mobile-filter-accordion');
    const content = accordion.querySelector('.mobile-filter-content');
    const isOpen = accordion.classList.contains('is-open');
    
    accordion.classList.toggle('is-open');
    
    if (isOpen) {
      content.style.maxHeight = '0';
      content.style.opacity = '0';
      button.setAttribute('aria-expanded', 'false');
    } else {
      content.style.maxHeight = content.scrollHeight + 'px';
      content.style.opacity = '1';
      button.setAttribute('aria-expanded', 'true');
    }
  }
  
  function clearAllFilters() {
    // Remove URL parameters and redirect to clean collection URL
    const currentUrl = window.location.pathname;
    window.location.href = currentUrl;
  }
  
  // Initialize price range functionality
  document.addEventListener('DOMContentLoaded', function() {
    const priceInputs = document.querySelectorAll('.filter-price-range__input');
    
    priceInputs.forEach(input => {
      input.addEventListener('change', function() {
        const container = this.closest('.filter-price-range');
        const minInput = container.querySelector('.filter-price-range__input:first-of-type');
        const maxInput = container.querySelector('.filter-price-range__input:last-of-type');
        
        const minValue = parseFloat(minInput.value) || 0;
        const maxValue = parseFloat(maxInput.value) || 999999;
        
        if (minValue || maxValue < 999999) {
          // Build URL with price filter
          const currentUrl = new URL(window.location);
          const searchParams = currentUrl.searchParams;
          
          if (minValue > 0 || maxValue < 999999) {
            searchParams.set('filter.v.price.gte', minValue * 100); // Shopify uses cents
            searchParams.set('filter.v.price.lte', maxValue * 100);
          } else {
            searchParams.delete('filter.v.price.gte');
            searchParams.delete('filter.v.price.lte');
          }
          
          // Debounce the redirect
          clearTimeout(this.priceFilterTimeout);
          this.priceFilterTimeout = setTimeout(() => {
            window.location.href = currentUrl.toString();
          }, 1000);
        }
      });
    });
  
    // Set initial values from URL
    const urlParams = new URLSearchParams(window.location.search);
    const minPrice = urlParams.get('filter.v.price.gte');
    const maxPrice = urlParams.get('filter.v.price.lte');
    
    if (minPrice) {
      const minInput = document.querySelector('.filter-price-range__input:first-of-type');
      if (minInput) minInput.value = (parseFloat(minPrice) / 100).toFixed(2);
    }
    
    if (maxPrice) {
      const maxInput = document.querySelector('.filter-price-range__input:last-of-type');
      if (maxInput) maxInput.value = (parseFloat(maxPrice) / 100).toFixed(2);
    }
  
    // Enhanced image loading
    const lazyImages = document.querySelectorAll('.highlight-tile__image img[loading="lazy"]');
    
    if ('IntersectionObserver' in window) {
      const imageObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const img = entry.target;
            img.addEventListener('load', () => {
              img.classList.add('loaded');
            });
            imageObserver.unobserve(img);
          }
        });
      });
      
      lazyImages.forEach(img => imageObserver.observe(img));
    } else {
      // Fallback for browsers without IntersectionObserver
      lazyImages.forEach(img => {
        img.addEventListener('load', () => {
          img.classList.add('loaded');
        });
      });
    }
  
    // Keyboard navigation enhancement
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        // Close mobile filters on Escape
        const openAccordion = document.querySelector('.mobile-filter-accordion.is-open');
        if (openAccordion) {
          const toggle = openAccordion.querySelector('.mobile-filter-toggle');
          if (toggle) toggleMobileFilters(toggle);
        }
      }
    });
  });
</script>

