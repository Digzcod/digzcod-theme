{% comment %} 
                                      Section: Hero Promo
                                      Files: 
                                      - sections/hero-promo.liquid 
                                      - assets/hero-promo.css 
                                      - assets/hero-promo.js
                                      Notes: 
                                      - No Tailwind; plain CSS for maximum theme compatibility. 
                                      - Highly customizable via schema settings & blocks. 
{% endcomment %}

{{ 'hero-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-banner.js' | asset_url }}" defer></script>

{%- assign s = section.settings -%}

<section
  id="hero-promo-{{ section.id }}"
  class="hero-promo hero-promo--desktop-position-{{ s.desktop_image_position | default: 'center' }} hero-promo--mobile-position-{{ s.mobile_image_position | default: 'center' }}"
  data-section-id="{{ section.id }}"
  data-section-type="hero-promo"
  style="
    --hp-content-max: {{ s.content_max_width }}px;
    --hp-padding-y: {{ s.padding_y }}px;
    --hp-padding-x: {{ s.padding_x }}px;
    --hp-radius: {{ s.corner_radius }}px;
    --hp-overlay: {{ s.overlay_color }};
    --hp-overlay-opacity: {{ s.overlay_opacity | divided_by: 100.0 }};
    --hp-text: {{ s.text_color }};
    --hp-accent: {{ s.accent_color }};
    --hp-section-height: {{ s.section_height | default: 70 }}vh;
    --hp-mobile-section-height: {{ s.mobile_section_height | default: 50 }}vh;
    --hp-tablet-section-height: {{ s.tablet_section_height | default: 60 }}vh;
    --hp-heading-size: {{ s.heading_size | default: 3.0 }}rem;
    --hp-subheading-size: {{ s.subheading_size | default: 1.2 }}rem;
    --hp-tablet-heading-size: {{ s.tablet_heading_size | default: s.heading_size | default: 2.8 }}rem;
    --hp-tablet-subheading-size: {{ s.tablet_subheading_size | default: s.subheading_size | default: 1.1 }}rem;
    --hp-mobile-heading-size: {{ s.mobile_heading_size }}rem;
    --hp-mobile-subheading-size: {{ s.mobile_subheading_size }}rem;
    --hp-mobile-padding-y: {{ s.mobile_padding_y }}px;
    --hp-mobile-padding-x: {{ s.mobile_padding_x }}px;
    --hp-tablet-padding-y: {{ s.tablet_padding_y | default: s.padding_y }}px;
    --hp-tablet-padding-x: {{ s.tablet_padding_x | default: s.padding_x }}px;
    --hp-heading-color: {{ s.heading_color | default: s.text_color }};
    --hp-subheading-color: {{ s.subheading_color | default: s.text_color }};
    --hp-body-color: {{ s.body_color | default: s.text_color }};
    --hp-tablet-heading-color: {{ s.tablet_heading_color | default: s.heading_color | default: s.text_color }};
    --hp-tablet-subheading-color: {{ s.tablet_subheading_color | default: s.subheading_color | default: s.text_color }};
    --hp-tablet-body-color: {{ s.tablet_body_color | default: s.body_color | default: s.text_color }};
    --hp-mobile-heading-color: {{ s.mobile_heading_color | default: s.heading_color | default: s.text_color }};
    --hp-mobile-subheading-color: {{ s.mobile_subheading_color | default: s.subheading_color | default: s.text_color }};
    --hp-mobile-body-color: {{ s.mobile_body_color | default: s.body_color | default: s.text_color }};
  "
  aria-label="{{ s.heading | escape | default: 'Promotional banner' }}">
  <div class="hero-promo__media">
    {%- if s.bg_video != blank -%}
      <video
        class="hero-promo__video"
        autoplay
        muted
        loop
        playsinline
        {% if s.video_poster != blank %}
        poster="{{ s.video_poster | image_url: width: 1920 }}"
        {% endif %}>
        <source src="{{ s.bg_video | file_url }}" type="video/mp4">
      </video>
    {%- else -%}
      {%- if s.bg_image != blank -%}
        <div
          class="hero-promo__background"
          style="background-image: url('{{ s.bg_image | image_url: width: 1920 }}');"
          role="img"
          aria-label="{{ s.bg_image.alt | escape | default: s.heading }}"></div>
      {%- endif -%}

      {%- if s.mobile_bg_image != blank -%}
        <div
          class="hero-promo__background hero-promo__background--mobile"
          style="background-image: url('{{ s.mobile_bg_image | image_url: width: 1200 }}');"
          role="img"
          aria-label="{{ s.mobile_bg_image.alt | escape | default: s.heading }}"></div>
      {%- endif -%}

      {%- if s.bg_image == blank and s.mobile_bg_image == blank -%}
        <div class="hero-promo__placeholder" aria-hidden="true"></div>
      {%- endif -%}
    {%- endif -%}
    <div class="hero-promo__overlay" aria-hidden="true"></div>
  </div>

  <div class="hero-promo__container hero-promo__container--{{ s.layout }}">
    <div class="hero-promo__content hero-promo__content--{{ s.align }} hero-promo__content--mobile-{{ s.mobile_align }}">
      {%- if s.kicker != blank -%}
        <p class="hero-promo__kicker">{{ s.kicker }}</p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h2 class="hero-promo__heading" style="--hp-heading-size: {{ s.heading_size }}rem;">
          {{ s.heading }}
        </h2>
      {%- endif -%}

      {%- if s.subheading != blank -%}
        <p class="hero-promo__subheading" style="--hp-subheading-size: {{ s.subheading_size }}rem;">
          {{ s.subheading }}
        </p>
      {%- endif -%}

      {%- if s.body != blank -%}
        <div class="hero-promo__richtext rte">
          {{ s.body }}
        </div>
    {%- endif -%}

      {%- comment -%} Separate badges and features from buttons for better content flow {%- endcomment -%}
      {%- assign has_badges_or_features = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'badge' or block.type == 'feature' -%}
          {%- assign has_badges_or_features = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if has_badges_or_features -%}
        <div class="hero-promo__extras">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'badge' -%}
                {%- assign b = block.settings -%}
                {%- if b.text != blank -%}
                  <span class="hp-badge hp-badge--{{ b.variation }}">{{ b.text }}</span>
                {%- endif -%}
              {%- when 'feature' -%}
                {%- assign f = block.settings -%}
                <div class="hp-feature">
                  {%- if f.icon != blank -%}
                    <img
                      class="hp-feature__icon"
                      src="{{ f.icon | image_url: width: 64 }}"
                      alt=""
                      width="32"
                      height="32"
                      loading="lazy">
                  {%- endif -%}
                  <div class="hp-feature__text">
                    <div class="hp-feature__title">{{ f.title }}</div>
                    {%- if f.caption != blank -%}
                      <div class="hp-feature__caption">{{ f.caption }}</div>
                    {%- endif -%}
                  </div>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
    {%- endif -%}

      {%- comment -%} Buttons as part of content flow {%- endcomment -%}
      {%- assign button_blocks = section.blocks | where: 'type', 'button' -%}
      {%- if button_blocks.size > 0 -%}
        <div class="hero-promo__buttons">
          {%- for block in button_blocks -%}
            {%- assign b = block.settings -%}
            {%- if b.label != blank and b.url != blank -%}
              <a
                class="hp-btn hp-btn--{{ b.style }} {% if b.outline %}hp-btn--outline{% endif %}"
                href="{{ b.url }}"
                {% if b.style == 'custom' %}
                style="
                  --btn-bg: {{ b.button_bg_color }};
                  --btn-text: {{ b.button_text_color }};
                  --btn-border: {{ b.button_border_color }};
                  --btn-border-width: {{ b.button_border_width }}px;
                  --btn-border-radius: {{ b.button_border_radius }}px;
                "
                {% endif %}
                {% if b.open_new_tab %}
                target="_blank"
                rel="noopener noreferrer"
                {% endif %}>
                {{ b.label }}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if s.enable_scroll_hint -%}
    <button
      class="hero-promo__scroll"
      data-scroll-hint
      aria-label="{{ 'general.scroll' | t | default: 'Scroll' }}">
      <span class="hero-promo__scroll-dot" aria-hidden="true"></span>
    </button>
  {%- endif -%}
</section>

{% schema %}
