<article class="article" itemscope itemtype="https://schema.org/Article" id="Article-{{ section.id }}">
  <div class="article__container">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'article_title' %}
          <header class="article__header" {{ block.shopify_attributes }}>
            <h1 class="article__title" itemprop="headline">
              {% if block.settings.custom_title != blank %}
                {{ block.settings.custom_title }}
              {% else %}
                {{ article.title }}
              {% endif %}
            </h1>
          </header>

        {% when 'article_meta' %}
          <div class="article__meta" {{ block.shopify_attributes }}>
            {% if section.settings.enable_author and article.author != blank %}
              <span class="article__author" itemprop="author" itemscope itemtype="https://schema.org/Person">
                <span itemprop="name">{{ 'blog.article.by_author' | t: author: article.author }}</span>
              </span>
            {% endif %}

            {% if section.settings.enable_publish_date %}
              <time class="article__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}" itemprop="datePublished">
                {{ article.published_at | date: format: 'abbreviated_date' }}
              </time>
            {% endif %}

            {% if article.moderated? and article.comments_count > 0 %}
              <span class="article__comments-count">
                <a href="#ArticleComments-{{ section.id }}" class="article__comments-link">
                  {{ 'blog.article.comments_count' | t: count: article.comments_count }}
                </a>
              </span>
            {% endif %}
          </div>

        {% when 'article_image' %}
          {% if section.settings.enable_featured_image and article.image %}
            <div class="article__featured-image" {{ block.shopify_attributes }}>
              <div class="article__image-wrapper">
                {{
                  article.image |
                  image_url: width: 1200 |
                  image_tag:
                    loading: 'eager',
                    sizes: '(min-width: 1200px) 800px, (min-width: 768px) calc(100vw - 10rem), calc(100vw - 4rem)',
                    widths: '375, 550, 750, 1100, 1500',
                    alt: article.image.alt | default: article.title,
                    itemprop: 'image'
                }}
              </div>
              {% if article.image.alt != blank %}
                <figcaption class="article__image-caption">{{ article.image.alt }}</figcaption>
              {% endif %}
            </div>
          {% endif %}

        {% when 'article_content' %}
          <div class="article__content rte" itemprop="articleBody" {{ block.shopify_attributes }}>
            {{ article.content }}
          </div>

        {% when 'article_tags' %}
          {% if section.settings.enable_tags and article.tags.size > 0 %}
            <div class="article__tags" {{ block.shopify_attributes }}>
              <h3 class="article__tags-heading">{{ 'blog.article.tagged' | t }}</h3>
              <ul class="article__tags-list" role="list">
                {% for tag in article.tags %}
                  <li class="article__tag-item">
                    <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="article__tag-link">
                      #{{ tag }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

        {% when 'article_social' %}
          {% if section.settings.enable_social_sharing %}
            <div class="article__social-sharing" {{ block.shopify_attributes }}>
              <h3 class="article__sharing-heading">Share this article</h3>
              <div class="article__social-links">
                <a
                  href="https://twitter.com/intent/tweet?text={{ article.title | url_encode }}&url={{ shop.url }}{{ article.url }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="article__social-link article__social-link--twitter"
                  aria-label="Share on Twitter"
                >
                  <span>Twitter</span>
                </a>
                <a
                  href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ article.url }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="article__social-link article__social-link--facebook"
                  aria-label="Share on Facebook"
                >
                  <span>Facebook</span>
                </a>
                <a
                  href="mailto:?subject={{ article.title | url_encode }}&body={{ shop.url }}{{ article.url }}"
                  class="article__social-link article__social-link--email"
                  aria-label="Share via email"
                >
                  <span>Email</span>
                </a>
              </div>
            </div>
          {% endif %}

      {% endcase %}
    {% endfor %}

    {% if blog.comments_enabled? %}
      <div class="article__comments-wrapper" id="ArticleComments-{{ section.id }}">
        {% if article.comments_count > 0 %}
          <h2 class="article__comments-heading">
            {{ 'blog.article.comments_count' | t: count: article.comments_count }}
          </h2>
          
          {% paginate article.comments by 5 %}
            <div class="article__comments">
              {% for comment in article.comments %}
                <div class="article__comment" id="Comment-{{ comment.id }}">
                  <div class="article__comment-header">
                    <span class="article__comment-author">{{ comment.author }}</span>
                    <time class="article__comment-date" datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">
                      {{ comment.created_at | date: format: 'abbreviated_date' }}
                    </time>
                  </div>
                  <div class="article__comment-content rte">
                    {{ comment.content }}
                  </div>
                </div>
              {% endfor %}
              
              {% if paginate.pages > 1 %}
                <nav class="pagination" role="navigation" aria-label="Pagination">
                  <ul class="pagination__list">
                    {% if paginate.previous %}
                      <li class="pagination__item">
                        <a href="{{ paginate.previous.url }}" class="pagination__link" rel="prev">
                          Previous
                        </a>
                      </li>
                    {% endif %}

                    {% for part in paginate.parts %}
                      {% if part.is_link %}
                        <li class="pagination__item">
                          <a href="{{ part.url }}" class="pagination__link">
                            {{ part.title }}
                          </a>
                        </li>
                      {% else %}
                        {% if part.title == paginate.current_page %}
                          <li class="pagination__item pagination__item--current">
                            <span class="pagination__link pagination__link--current" aria-current="page">
                              {{ part.title }}
                            </span>
                          </li>
                        {% else %}
                          <li class="pagination__item">
                            <span class="pagination__link">{{ part.title }}</span>
                          </li>
                        {% endif %}
                      {% endif %}
                    {% endfor %}

                    {% if paginate.next %}
                      <li class="pagination__item">
                        <a href="{{ paginate.next.url }}" class="pagination__link" rel="next">
                          Next
                        </a>
                      </li>
                    {% endif %}
                  </ul>
                </nav>
              {% endif %}
            </div>
          {% endpaginate %}
        {% endif %}

        {% form 'new_comment', article, class: 'article__comment-form' %}
          <h2 class="article__comment-form-heading">{{ 'blog.article.write_comment' | t }}</h2>
          
          {% if form.errors %}
            <div class="form__message form__message--error" role="alert">
              <h3 class="form__message-title">{{ 'blog.article.comment_error_title' | t }}</h3>
              <ul class="form__message-list">
                {% for field in form.errors %}
                  <li>
                    {% if field == 'form' %}
                      {{ form.errors.messages[field] }}
                    {% else %}
                      {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          {% if form.posted_successfully? %}
            <div class="form__message form__message--success" role="status">
              {% if blog.moderated? %}
                {{ 'blog.article.comment_success_moderated' | t }}
              {% else %}
                {{ 'blog.article.comment_success' | t }}
              {% endif %}
            </div>
          {% endif %}

          <div class="article__comment-form-grid">
            <div class="field">
              <label for="CommentForm-author" class="field__label">
                {{ 'blog.article.comment_form_name' | t }}
                <span aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                name="comment[author]"
                id="CommentForm-author"
                class="field__input"
                autocomplete="name"
                value="{{ form.author }}"
                aria-required="true"
                required
                {% if form.errors contains 'author' %}
                  aria-invalid="true"
                  aria-describedby="CommentForm-author-error"
                {% endif %}
              >
              {% if form.errors contains 'author' %}
                <small id="CommentForm-author-error" class="field__error">
                  <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                  {{ form.errors.translated_fields.author | capitalize }}
                  {{ form.errors.messages.author }}.
                </small>
              {% endif %}
            </div>

            <div class="field">
              <label for="CommentForm-email" class="field__label">
                {{ 'blog.article.comment_form_email' | t }}
                <span aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                name="comment[email]"
                id="CommentForm-email"
                class="field__input"
                autocomplete="email"
                value="{{ form.email }}"
                aria-required="true"
                required
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="CommentForm-email-error"
                {% endif %}
              >
              {% if form.errors contains 'email' %}
                <small id="CommentForm-email-error" class="field__error">
                  <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}.
                </small>
              {% endif %}
            </div>

            <div class="field field--body">
              <label for="CommentForm-body" class="field__label">
                {{ 'blog.article.comment_form_comment' | t }}
                <span aria-hidden="true">*</span>
              </label>
              <textarea
                name="comment[body]"
                id="CommentForm-body"
                class="field__input field__input--textarea"
                rows="5"
                aria-required="true"
                required
                {% if form.errors contains 'body' %}
                  aria-invalid="true"
                  aria-describedby="CommentForm-body-error"
                {% endif %}
              >{{ form.body }}</textarea>
              {% if form.errors contains 'body' %}
                <small id="CommentForm-body-error" class="field__error">
                  <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                  {{ form.errors.translated_fields.body | capitalize }}
                  {{ form.errors.messages.body }}.
                </small>
              {% endif %}
            </div>
          </div>

          <button type="submit" class="button button--primary">
            {{ 'blog.article.comment_form_submit' | t }}
          </button>
        {% endform %}
      </div>
    {% endif %}
  </div>
</article>

