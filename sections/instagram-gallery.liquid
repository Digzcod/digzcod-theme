{%- liquid
  assign section_id = 'InstagramGallery-' | append: section.id
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign instagram_handle = section.settings.instagram_handle
  assign gallery_layout = section.settings.gallery_layout
  assign columns_desktop = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile
  assign image_aspect_ratio = section.settings.image_aspect_ratio
  assign enable_hover_effects = section.settings.enable_hover_effects
  assign show_instagram_icon = section.settings.show_instagram_icon
  assign button_text = section.settings.button_text | default: 'Follow Us'
  assign button_url = section.settings.button_url
  assign color_scheme = section.settings.color_scheme
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign content_width = section.settings.content_width
  assign image_spacing = section.settings.image_spacing
  assign content_alignment = section.settings.content_alignment
  assign enable_lightbox = section.settings.enable_lightbox
  assign overlay_opacity = section.settings.overlay_opacity
-%}

{% stylesheet %}
  .instagram-gallery {
    padding-top: var(--instagram-gallery-padding-top, 4rem);
    padding-bottom: var(--instagram-gallery-padding-bottom, 4rem);
  }

  .instagram-gallery[data-color-scheme="1"] {
    background-color: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.87);
  }

  .instagram-gallery[data-color-scheme="2"] {
    background-color: rgb(var(--color-accent-1));
    color: rgba(var(--color-accent-1-text), 0.87);
  }

  .instagram-gallery[data-color-scheme="3"] {
    background-color: rgb(var(--color-accent-2));
    color: rgba(var(--color-accent-2-text), 0.87);
  }

  .instagram-gallery__container {
    max-width: var(--instagram-gallery-content-width, 120rem);
    margin: 0 auto;
    padding: 0 var(--page-padding, 1.5rem);
  }

  .instagram-gallery__header {
    text-align: var(--instagram-gallery-content-alignment, center);
    margin-bottom: var(--instagram-gallery-header-spacing, 3rem);
  }

  .instagram-gallery__heading {
    margin: 0;
    font-size: var(--font-size-h2, 2.5rem);
    font-weight: var(--font-weight-bold, 700);
    line-height: var(--line-height-tight, 1.2);
    letter-spacing: var(--letter-spacing-tight, -0.025em);
    display: flex;
    align-items: center;
    justify-content: var(--instagram-gallery-content-alignment, center);
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .instagram-gallery__heading-icon {
    width: 2rem;
    height: 2rem;
    fill: currentColor;
  }

  .instagram-gallery__subheading {
    margin: 1rem auto 0;
    font-size: var(--font-size-lg, 1.125rem);
    line-height: var(--line-height-relaxed, 1.625);
    opacity: 0.8;
    max-width: 60ch;
  }

  .instagram-gallery__grid {
    display: grid;
    gap: var(--instagram-gallery-image-spacing, 1rem);
    margin-bottom: var(--instagram-gallery-footer-spacing, 3rem);
  }

  .instagram-gallery__grid[data-layout="square"] {
    grid-template-columns: repeat(var(--instagram-gallery-columns-desktop, 3), 1fr);
  }

  .instagram-gallery__grid[data-layout="masonry"] {
    grid-template-columns: repeat(var(--instagram-gallery-columns-desktop, 3), 1fr);
    grid-auto-rows: 200px;
  }

  .instagram-gallery__grid[data-layout="featured"] {
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 1fr);
    aspect-ratio: 16 / 9;
  }

  .instagram-gallery__grid[data-layout="featured"] .instagram-gallery__item:first-child {
    grid-column: 1 / 3;
    grid-row: 1 / 3;
  }

  .instagram-gallery__item {
    position: relative;
    overflow: hidden;
    border-radius: var(--border-radius-card, 0.75rem);
    background-color: rgba(var(--color-background-2), 1);
    transition: var(--transition-card, transform 0.2s ease, box-shadow 0.2s ease);
  }

  .instagram-gallery__item:hover {
    transform: var(--card-hover-transform, translateY(-2px));
    box-shadow: var(--shadow-card-hover, 0 10px 25px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05));
    z-index: 1;
  }

  .instagram-gallery__item[data-aspect-ratio="square"] {
    aspect-ratio: 1 / 1;
  }

  .instagram-gallery__item[data-aspect-ratio="portrait"] {
    aspect-ratio: 3 / 4;
  }

  .instagram-gallery__item[data-aspect-ratio="landscape"] {
    aspect-ratio: 4 / 3;
  }

  .instagram-gallery__item[data-aspect-ratio="wide"] {
    aspect-ratio: 16 / 9;
  }

  .instagram-gallery__link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    text-decoration: none;
    color: inherit;
  }

  .instagram-gallery__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition-image, transform 0.3s ease);
  }

  .instagram-gallery__item:hover .instagram-gallery__image {
    transform: var(--image-hover-transform, scale(1.05));
  }

  .instagram-gallery__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(0, 0, 0, var(--instagram-overlay-opacity, 0.3)) 0%, transparent 50%);
    opacity: 0;
    transition: var(--transition-colors, opacity 0.3s ease);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .instagram-gallery__item[data-hover-effects="true"]:hover .instagram-gallery__overlay {
    opacity: 1;
  }

  .instagram-gallery__overlay-content {
    text-align: center;
    color: white;
    z-index: 2;
  }

  .instagram-gallery__overlay-icon {
    width: 2rem;
    height: 2rem;
    fill: currentColor;
    margin-bottom: 0.5rem;
    opacity: 0.9;
  }

  .instagram-gallery__overlay-text {
    font-size: var(--font-size-sm, 0.875rem);
    font-weight: var(--font-weight-medium, 500);
    margin: 0;
    opacity: 0.9;
  }

  .instagram-gallery__footer {
    text-align: var(--instagram-gallery-content-alignment, center);
  }

  .instagram-gallery__button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    background: linear-gradient(45deg, #833ab4, #fd1d1d, #fcb045);
    color: white;
    text-decoration: none;
    border-radius: var(--border-radius-button, 0.5rem);
    font-weight: var(--font-weight-medium, 500);
    font-size: var(--font-size-base, 1rem);
    transition: var(--transition-colors, transform 0.2s ease, box-shadow 0.2s ease);
    border: none;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .instagram-gallery__button::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.5s;
  }

  .instagram-gallery__button:hover::before {
    left: 100%;
  }

  .instagram-gallery__button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }

  .instagram-gallery__button-icon {
    width: 1.25rem;
    height: 1.25rem;
    fill: currentColor;
  }

  .instagram-gallery__empty {
    text-align: center;
    padding: 3rem 1.5rem;
    opacity: 0.6;
  }

  .instagram-gallery__empty-icon {
    width: 3rem;
    height: 3rem;
    margin: 0 auto 1rem;
    opacity: 0.5;
    fill: currentColor;
  }

  .instagram-gallery__empty-title {
    margin: 0 0 0.5rem;
    font-size: var(--font-size-lg, 1.125rem);
    font-weight: var(--font-weight-semibold, 600);
  }

  .instagram-gallery__empty-text {
    margin: 0;
    font-size: var(--font-size-base, 1rem);
  }

  /* Lightbox styles */
  .instagram-lightbox {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.9);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 2rem;
  }

  .instagram-lightbox.active {
    display: flex;
  }

  .instagram-lightbox__image {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: var(--border-radius-card, 0.75rem);
  }

  .instagram-lightbox__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: white;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    backdrop-filter: blur(10px);
    transition: var(--transition-colors, background-color 0.2s ease);
  }

  .instagram-lightbox__close:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  /* Mobile styles */
  @media screen and (max-width: 749px) {
    .instagram-gallery__grid {
      grid-template-columns: repeat(var(--instagram-gallery-columns-mobile, 2), 1fr) !important;
      gap: var(--instagram-gallery-image-spacing-mobile, 0.75rem);
    }

    .instagram-gallery__grid[data-layout="featured"] {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto auto;
    }

    .instagram-gallery__grid[data-layout="featured"] .instagram-gallery__item:first-child {
      grid-column: 1 / 3;
      grid-row: 1;
    }

    .instagram-gallery__heading {
      font-size: var(--font-size-xl, 1.25rem);
      justify-content: center;
    }

    .instagram-gallery__button {
      padding: 0.875rem 1.5rem;
      font-size: var(--font-size-sm, 0.875rem);
    }

    .instagram-lightbox {
      padding: 1rem;
    }

    .instagram-lightbox__close {
      top: 0.5rem;
      right: 0.5rem;
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  @media screen and (min-width: 750px) and(max-width: 989px) {
    .instagram-gallery__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .instagram-gallery__grid[data-layout="featured"] {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(2, 1fr);
    }

    .instagram-gallery__grid[data-layout="featured"] .instagram-gallery__item:first-child {
      grid-column: 1 / 2;
      grid-row: 1 / 3;
    }
  }
{% endstylesheet %}

<section
  id="{{ section_id }}"
  class="instagram-gallery section-{{ section.id }}"
  data-color-scheme="{{ color_scheme }}"
  style="
    --instagram-gallery-padding-top: {{ padding_top }}rem;
    --instagram-gallery-padding-bottom: {{ padding_bottom }}rem;
    --instagram-gallery-content-width: {{ content_width }}rem;
    --instagram-gallery-image-spacing: {{ image_spacing }}rem;
    --instagram-gallery-image-spacing-mobile: {{ image_spacing | times: 0.75 }}rem;
    --instagram-gallery-content-alignment: {{ content_alignment }};
    --instagram-gallery-columns-desktop: {{ columns_desktop }};
    --instagram-gallery-columns-mobile: {{ columns_mobile }};
    --instagram-overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }};
  "
  aria-labelledby="InstagramGallery-heading-{{ section.id }}">

  <div class="instagram-gallery__container">
    {%- if heading != blank or subheading != blank -%}
      <header class="instagram-gallery__header">
        {%- if heading != blank -%}
          <h2 id="InstagramGallery-heading-{{ section.id }}" class="instagram-gallery__heading">
            {%- if show_instagram_icon -%}
              <svg
                class="instagram-gallery__heading-icon"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
              </svg>
            {%- endif -%}
            {{ heading }}
            {%- if instagram_handle != blank -%}
              <span style="font-weight: var(--font-weight-normal, 400); color: rgba(var(--color-accent-1), 1);">@{{ instagram_handle }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}

        {%- if subheading != blank -%}
          <div class="instagram-gallery__subheading rte">
            {{ subheading }}
          </div>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="instagram-gallery__grid" data-layout="{{ gallery_layout }}">

        {%- for block in section.blocks -%}
          {%- liquid
            assign image = block.settings.image
            assign alt_text = block.settings.alt_text | default: image.alt
            assign link_url = block.settings.link_url
            assign caption = block.settings.caption
            assign block_id = 'InstagramItem-' | append: block.id
          -%}

          <div
            class="instagram-gallery__item"
            data-aspect-ratio="{{ image_aspect_ratio }}"
            data-hover-effects="{{ enable_hover_effects }}"
            id="{{ block_id }}"
            {{ block.shopify_attributes }}>

            {%- if image -%}
              {%- liquid
                assign link_tag_start = ''
                assign link_tag_end = ''

                if link_url != blank
                  assign link_tag_start = '<a href="' | append: link_url | append: '" class="instagram-gallery__link" target="_blank" rel="noopener">'
                  assign link_tag_end = '</a>'
                elsif enable_lightbox
                  assign link_tag_start = '<button type="button" class="instagram-gallery__link" data-lightbox-trigger data-image-src="' | append: image | append: '">'
                  assign link_tag_end = '</button>'
                endif
              -%}

              {{ link_tag_start }}
              <img
                src="{{ image | image_url: width: 800 }}"
                alt="{{ alt_text }}"
                class="instagram-gallery__image"
                loading="lazy"
                width="800"
                height="800"
                sizes="(min-width: 990px) calc((100vw - 6rem) / {{ columns_desktop }}), (min-width: 750px) calc((100vw - 4rem) / 3), calc((100vw - 3rem) / {{ columns_mobile }})"
                srcset="{{ image | image_url: width: 200 }} 200w, {{ image | image_url: width: 300 }} 300w, {{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 500 }} 500w, {{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 800 }} 800w, {{ image | image_url: width: 1000 }} 1000w">

              {%- if enable_hover_effects -%}
                <div class="instagram-gallery__overlay">
                  <div class="instagram-gallery__overlay-content">
                    <svg
                      class="instagram-gallery__overlay-icon"
                      viewBox="0 0 24 24"
                      fill="currentColor">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                    </svg>
                    {%- if caption != blank -%}
                      <p class="instagram-gallery__overlay-text">{{ caption }}</p>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
              {{ link_tag_end }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if button_text != blank and button_url != blank -%}
        <footer class="instagram-gallery__footer">
          <a
            href="{{ button_url }}"
            class="instagram-gallery__button"
            target="_blank"
            rel="noopener">
            <svg
              class="instagram-gallery__button-icon"
              viewBox="0 0 24 24"
              fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
            {{ button_text }}
          </a>
        </footer>
      {%- endif -%}
    {%- else -%}
      <div class="instagram-gallery__empty">
        <svg
          class="instagram-gallery__empty-icon"
          viewBox="0 0 24 24"
          fill="currentColor">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
        </svg>
        <h3 class="instagram-gallery__empty-title">{{ 'instagram.general.no_images' | t | default: 'No Images Added' }}</h3>
        <p class="instagram-gallery__empty-text">{{ 'instagram.general.no_images_desc' | t | default: 'Add lifestyle photos to showcase your brand.' }}</p>
      </div>
    {%- endif -%}
  </div>

  {%- if enable_lightbox -%}
    <div class="instagram-lightbox" data-lightbox>
      <button
        type="button"
        class="instagram-lightbox__close"
        data-lightbox-close
        aria-label="{{ 'general.close' | t }}">&times;</button>
      <img
        class="instagram-lightbox__image"
        data-lightbox-image
        alt=""
        width="800"
        height="600">
    </div>
  {%- endif -%}
</section>

{%- if enable_lightbox -%}
  <script>
    class InstagramLightbox {
      constructor() {
        this.lightbox = document.querySelector('[data-lightbox]');
        this.lightboxImage = document.querySelector('[data-lightbox-image]');
        this.triggers = document.querySelectorAll('[data-lightbox-trigger]');
        this.closeButton = document.querySelector('[data-lightbox-close]');
        
        this.init();
      }
    
      init() {
        if (!this.lightbox) return;
    
        this.triggers.forEach(trigger => {
          trigger.addEventListener('click', (e) => this.openLightbox(e));
        });
    
        this.closeButton.addEventListener('click', () => this.closeLightbox());
        this.lightbox.addEventListener('click', (e) => {
          if (e.target === this.lightbox) this.closeLightbox();
        });
    
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.lightbox.classList.contains('active')) {
            this.closeLightbox();
          }
        });
      }
    
      openLightbox(e) {
        const imageSrc = e.currentTarget.dataset.imageSrc;
        if (!imageSrc) return;
    
        this.lightboxImage.src = imageSrc;
        this.lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    
      closeLightbox() {
        this.lightbox.classList.remove('active');
        document.body.style.overflow = '';
        this.lightboxImage.src = '';
      }
    }
    
    document.addEventListener('DOMContentLoaded', () => {
      new InstagramLightbox();
    });
  </script>
{%- endif -%}

