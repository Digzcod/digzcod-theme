<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    
    
    {% # Load Tailwind CSS %}
    {{ 'output.css' | asset_url | stylesheet_tag }}

    {% # Load Header Dropdown Styles %}
    {{ 'header-dropdown.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
   
  </head>

  <body class="">
    {% sections 'header-step' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
  </body>
</html>
